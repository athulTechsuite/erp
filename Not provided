  // TC-005: Database migration
  describe('TC-005: Database migration', () => {
    let databaseMigration;
    let mockConnection;

    beforeEach(() => {
      mockConnection = {
        query: sinon.stub(),
        beginTransaction: sinon.stub(),
        commit: sinon.stub(),
        rollback: sinon.stub(),
        end: sinon.stub()
      };
      databaseMigration = new DatabaseMigration(mockConnection);
    });

    describe('Happy Path', () => {
      it('should execute migration successfully', async () => {
        mockConnection.beginTransaction.resolves();
        mockConnection.query.onFirstCall().resolves();
        mockConnection.query.onSecondCall().resolves();
        mockConnection.commit.resolves();

        const result = await databaseMigration.migrate();

        expect(result.success).to.be.true;
        expect(mockConnection.beginTransaction.calledOnce).to.be.true;
        expect(mockConnection.commit.calledOnce).to.be.true;
      });

      it('should create announcements table correctly', async () => {
        mockConnection.query.resolves();
        
        await databaseMigration.createAnnouncementsTable();
        
        const expectedSQL = `
          CREATE TABLE IF NOT EXISTS announcements (
            id INT PRIMARY KEY AUTO_INCREMENT,
            title VARCHAR(255) NOT NULL,
            content TEXT NOT NULL,
            priority ENUM('low', 'medium', 'high', 'critical') DEFAULT 'medium',
            category VARCHAR(100),
            publish_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
          )
        `;
        
        expect(mockConnection.query.calledWith(expectedSQL.trim())).to.be.true;
      });

      it('should create indexes successfully', async () => {
        mockConnection.query.resolves();
        
        await databaseMigration.createIndexes();
        
        expect(mockConnection.query.callCount).to.equal(3);
        expect(mockConnection.query.calledWith('CREATE INDEX idx_announcements_priority ON announcements(priority)')).to.be.true;
        expect(mockConnection.query.calledWith('CREATE INDEX idx_announcements_category ON announcements(category)')).to.be.true;
        expect(mockConnection.query.calledWith('CREATE INDEX idx_announcements_publish_date ON announcements(publish_date)')).to.be.true;
      });

      it('should execute full migration with all steps', async () => {
        mockConnection.beginTransaction.resolves();
        mockConnection.query.resolves();
        mockConnection.commit.resolves();

        const result = await databaseMigration.runFullMigration();

        expect(result.success).to.be.true;
        expect(result.steps).to.include('Table created');
        expect(result.steps).to.include('Indexes created');
        expect(result.steps).to.include('Initial data inserted');
      });

      it('should validate migration status correctly', async () => {
        mockConnection.query.withArgs('SHOW TABLES LIKE "announcements"').resolves([{ Tables_in_db: 'announcements' }]);
        mockConnection.query.withArgs('SHOW INDEX FROM announcements').resolves([
          { Key_name: 'idx_announcements_priority' },
          { Key_name: 'idx_announcements_category' }
        ]);

        const result = await databaseMigration.validateMigration();

        expect(result.tableExists).to.be.true;
        expect(result.indexesCreated).to.be.true;
        expect(result.isValid).to.be.true;
      });
    });

    describe('Error Path', () => {
      it('should rollback transaction on migration failure', async () => {
        const migrationError = new Error('Table creation failed');
        
        mockConnection.beginTransaction.resolves();
        mockConnection.query.rejects(migrationError);
        mockConnection.rollback.resolves();

        const result = await databaseMigration.migrate();

        expect(result.success).to.be.false;
        expect(result.error).to.equal('Table creation failed');
        expect(mockConnection.rollback.calledOnce).to.be.true;
        expect(mockConnection.commit.called).to.be.false;
      });

      it('should handle connection error during transaction start', async () => {
        const connectionError = new Error('Connection timeout');
        
        mockConnection.beginTransaction.rejects(connectionError);

        const result = await databaseMigration.migrate();

        expect(result.success).to.be.false;
        expect(result.error).to.equal('Connection timeout');
        expect(mockConnection.rollback.called).to.be.false;
        expect(mockConnection.commit.called).to.be.false;
      });

      it('should handle constraint violation during table creation', async () => {
        const constraintError = new Error('Duplicate column name');
        
        mockConnection.beginTransaction.resolves();
        mockConnection.query.rejects(constraintError);
        mockConnection.rollback.resolves();

        await expect(databaseMigration.createAnnouncementsTable())
          .to.be.rejectedWith('Duplicate column name');
      });

      it('should handle index creation failure gracefully', async () => {
        const indexError = new Error('Index already exists');
        
        mockConnection.query.onFirstCall().resolves();
        mockConnection.query.onSecondCall().rejects(indexError);

        const result = await databaseMigration.createIndexes();

        expect(result.partialSuccess).to.be.true;
        expect(result.errors).to.include('Index already exists');
      });

      it('should handle rollback failure gracefully', async () => {
        const migrationError = new Error('Table creation failed');
        const rollbackError = new Error('Rollback failed');
        
        mockConnection.beginTransaction.resolves();
        mockConnection.query.rejects(migrationError);
        mockConnection.rollback.rejects(rollbackError);

        const result = await databaseMigration.migrate();

        expect(result.success).to.be.false;
        expect(result.error).to.equal('Table creation failed');
        expect(result.rollbackError).to.equal('Rollback failed');
      });

      it('should handle validation failure when table does not exist', async () => {
        mockConnection.query.withArgs('SHOW TABLES LIKE "announcements"').resolves([]);

        const result = await databaseMigration.validateMigration();

        expect(result.tableExists).to.be.false;
        expect(result.isValid).to.be.false;
        expect(result.errors).to.include('Announcements table does not exist');
      });

      it('should handle database permission errors', async () => {
