      mockDatabase.transaction.mockRejectedValue({
        name: 'DatabaseError',
        message: 'deadlock detected',
        code: '40P01',
        hint: 'See server log for query details.',
        detail: 'Process 12345 waits for ShareLock on transaction 67890; blocked by process 54321.'
      });

      const operations = [
        { action: 'update', table: 'announcements', id: 1, data: { title: 'Updated Title' } },
        { action: 'update', table: 'users', id: 123, data: { lastActive: '2023-12-01T11:30:00Z' } }
      ];

      await expect(mockDatabase.transaction(operations)).rejects.toMatchObject({
        code: '40P01',
        message: 'deadlock detected'
      });
    });

    it('TC-004: should handle SQL injection attempt in database query', async () => {
      mockDatabase.query.mockRejectedValue({
        name: 'DatabaseError',
        message: 'syntax error at or near "DROP"',
        code: '42601',
        position: '45',
        query: 'SELECT * FROM announcements WHERE title = \'Test\'; DROP TABLE users; --\''
      });

      const maliciousQuery = 'SELECT * FROM announcements WHERE title = $1';
      const maliciousParam = 'Test\'; DROP TABLE users; --';

      await expect(mockDatabase.query(maliciousQuery, [maliciousParam]))
        .rejects.toMatchObject({
          code: '42601',
          message: 'syntax error at or near "DROP"'
        });
    });

    it('TC-004: should handle database disk space full error', async () => {
      mockAnnouncementRepository.create.mockRejectedValue({
        name: 'DatabaseError',
        message: 'could not extend file "base/16384/16407": No space left on device',
        code: '53100',
        hint: 'Check free disk space.',
        severity: 'ERROR'
      });

      await expect(mockAnnouncementRepository.create({
        title: 'Large Announcement',
        content: 'A'.repeat(10000),
        userId: 123
      })).rejects.toMatchObject({
        code: '53100',
        message: expect.stringContaining('No space left on device')
      });
    });

    it('TC-004: should handle database connection pool exhaustion', async () => {
      mockDatabase.query.mockRejectedValue({
        name: 'PoolError',
        message: 'Connection pool exhausted. Maximum of 20 connections allowed.',
        code: 'POOL_EXHAUSTED',
        activeConnections: 20,
        maxConnections: 20,
        queueLength: 15
      });

      await expect(mockDatabase.query('SELECT 1', [])).rejects.toMatchObject({
        code: 'POOL_EXHAUSTED',
        activeConnections: 20,
        maxConnections: 20
      });
    });

    it('TC-004: should handle database backup failure', async () => {
      mockDatabase.backup.mockResolvedValue({
        success: false,
        error: 'Backup failed: insufficient disk space in backup directory',
        code: 'BACKUP_FAILED',
        backupPath: '/var/backups/announcements_db',
        requiredSpace: '2.5GB',
        availableSpace: '1.2GB'
      });

      const result = await mockDatabase.backup({
        path: '/var/backups/announcements_db',
        format: 'custom',
        compress: true
      });

      expect(result.success).toBe(false);
      expect(result.code).toBe('BACKUP_FAILED');
      expect(result.requiredSpace).toBe('2.5GB');
      expect(result.availableSpace).toBe('1.2GB');
    });

    it('TC-004: should handle optimistic locking conflict', async () => {
      mockAnnouncementRepository.update.mockRejectedValue({
        name: 'OptimisticLockError',
        message: 'Record was modified by another transaction',
        code: 'OPTIMISTIC_LOCK_FAILED',
        currentVersion: 3,
        expectedVersion: 2,
        recordId: 1
      });

      await expect(mockAnnouncementRepository.update(1, {
        title: 'Updated Title',
        version: 2 // Outdated version
      })).rejects.toMatchObject({
        code: 'OPTIMISTIC_LOCK_FAILED',
        currentVersion: 3,
        expectedVersion: 2
      });
    });

    it('TC-004: should handle database query timeout', async () => {
      mockDatabase.query.mockRejectedValue({
        name: 'QueryTimeoutError',
        message: 'Query execution exceeded timeout of 30000ms',
        code: 'QUERY_TIMEOUT',
        timeout: 30000,
        query: 'SELECT * FROM announcements a JOIN users u ON a.user_id = u.id WHERE u.created_at < $1'
      });

      const slowQuery = 'SELECT * FROM announcements a JOIN users u ON a.user_id = u.id WHERE u.created_at < $1';
      
      await expect(mockDatabase.query(slowQuery, ['2020-01-01'], { timeout: 30000 }))
        .rejects.toMatchObject({
          code: 'QUERY_TIMEOUT',
          timeout: 30000
        });
    });

    it('TC-004: should handle database migration failure during schema change', async () => {
      mockDatabase.query.mockRejectedValue({
        name: 'DatabaseError',
        message: 'cannot ALTER TABLE "announcements" because it has pending trigger events',
        code: '25006',
        hint: 'Complete all pending transactions before altering table schema.',
        table: 'announcements'
      });

      const migrationQuery = 'ALTER TABLE announcements ADD COLUMN priority INTEGER DEFAULT 1';

      await expect(mockDatabase.query(migrationQuery, []))
        .rejects.toMatchObject({
          code: '25006',
          table: 'announcements'
        });
    });
  });
});

