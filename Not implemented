import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { jest } from '@jest/globals';
import AnnouncementForm from '../components/AnnouncementForm';
import { AuthProvider } from '../contexts/AuthContext';
import { act } from 'react-dom/test-utils';

// Mock dependencies
const mockSubmit = jest.fn();
const mockAuthContext = {
  user: { id: 'user123', role: 'admin' },
  isAuthenticated: true,
  login: jest.fn(),
  logout: jest.fn()
};

const TestWrapper = ({ children, authContext = mockAuthContext }) => (
  <AuthProvider value={authContext}>
    {children}
  </AuthProvider>
);

describe('TC-003: AnnouncementForm component validation and submission', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('TC-003 Happy Path - Form validation and successful submission', () => {
    it('should validate required fields and submit successfully with valid data', async () => {
      const user = userEvent.setup();
      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Fill form with valid data
      const titleInput = screen.getByLabelText(/title/i);
      const contentInput = screen.getByLabelText(/content/i);
      const submitButton = screen.getByRole('button', { name: /submit/i });

      await user.type(titleInput, 'Test Announcement Title');
      await user.type(contentInput, 'This is a test announcement content with sufficient length');

      // Submit form
      await user.click(submitButton);

      await waitFor(() => {
        expect(mockSubmit).toHaveBeenCalledWith({
          title: 'Test Announcement Title',
          content: 'This is a test announcement content with sufficient length'
        });
      });

      expect(screen.queryByRole('alert')).not.toBeInTheDocument();
    });

    it('should handle optional fields correctly during submission', async () => {
      const user = userEvent.setup();
      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Test Title');
      await user.type(screen.getByLabelText(/content/i), 'Test content');
      
      const categorySelect = screen.getByLabelText(/category/i);
      await user.selectOptions(categorySelect, 'general');

      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmit).toHaveBeenCalledWith({
          title: 'Test Title',
          content: 'Test content',
          category: 'general'
        });
      });
    });
  });

  describe('TC-003 Error Path - Form validation failures', () => {
    it('should display validation errors for empty required fields', async () => {
      const user = userEvent.setup();
      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      const submitButton = screen.getByRole('button', { name: /submit/i });
      await user.click(submitButton);

      await waitFor(() => {
        expect(screen.getByText(/title is required/i)).toBeInTheDocument();
        expect(screen.getByText(/content is required/i)).toBeInTheDocument();
      });

      expect(mockSubmit).not.toHaveBeenCalled();
    });

    it('should validate minimum length requirements', async () => {
      const user = userEvent.setup();
      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'ab'); // Too short
      await user.type(screen.getByLabelText(/content/i), 'short'); // Too short
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/title must be at least 3 characters/i)).toBeInTheDocument();
        expect(screen.getByText(/content must be at least 10 characters/i)).toBeInTheDocument();
      });

      expect(mockSubmit).not.toHaveBeenCalled();
    });

    it('should handle submission errors gracefully', async () => {
      const user = userEvent.setup();
      const mockSubmitError = jest.fn().mockRejectedValue(new Error('Server error'));
      
      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitError} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Valid Title');
      await user.type(screen.getByLabelText(/content/i), 'Valid content for testing');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/failed to submit announcement/i)).toBeInTheDocument();
      });
    });
  });
});

describe('TC-004: Authorization and security tests', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('TC-004 Happy Path - Authorized access and operations', () => {
    it('should allow authenticated admin users to access AnnouncementForm', () => {
      const adminAuthContext = {
        user: { id: 'admin123', role: 'admin' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={adminAuthContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
      expect(screen.getByLabelText(/content/i)).toBeEnabled();
      expect(screen.getByRole('button', { name: /submit/i })).toBeEnabled();
    });

    it('should allow authenticated moderator users to access AnnouncementForm', () => {
      const moderatorAuthContext = {
        user: { id: 'mod123', role: 'moderator' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={moderatorAuthContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.queryByText(/unauthorized/i)).not.toBeInTheDocument();
    });

    it('should validate user permissions for sensitive operations', async () => {
      const user = userEvent.setup();
      const mockSubmitWithAuth = jest.fn().mockResolvedValue({ success: true });

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitWithAuth} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Authorized Announcement');
      await user.type(screen.getByLabelText(/content/i), 'This announcement is created by authorized user');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmitWithAuth).toHaveBeenCalledWith(
          expect.objectContaining({
            title: 'Authorized Announcement',
            content: 'This announcement is created by authorized user'
          })
        );
      });
    });
  });

  describe('TC-004 Error Path - Unauthorized access and security violations', () => {
    it('should deny access to unauthenticated users', () => {
      const unauthenticatedContext = {
        user: null,
        isAuthenticated: false,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={unauthenticatedContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should deny access to users with insufficient privileges', () => {
      const regularUserContext = {
        user: { id: 'user123', role: 'user' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={regularUserContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/insufficient privileges/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should handle token expiration gracefully', async () => {
      const user = userEvent.setup();
      const expiredTokenContext = {
        user: { id: 'admin123', role: 'admin' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      const mockSubmitTokenError = jest.fn().mockRejectedValue({
        response: { status: 401, data: { message: 'Token expired' } }
      });

      render(
        <TestWrapper authContext={expiredTokenContext}>
          <AnnouncementForm onSubmit={mockSubmitTokenError} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Test Title');
      await user.type(screen.getByLabelText(/content/i), 'Test content');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/session expired.*please log in again/i)).toBeInTheDocument();
      });

      expect(expiredTokenContext.logout).toHaveBeenCalled();
    });

    it('should prevent CSRF attacks by validating request tokens', async () => {
      const user = userEvent.setup();
      const mockSubmitCSRF = jest.fn().mockRejectedValue({
        response: { status: 403, data: { message: 'CSRF token mismatch' } }
      });

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitCSRF} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'CSRF Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing CSRF protection');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/security validation failed/i)).toBeInTheDocument();
      });
    });

    it('should sanitize user input to prevent XSS attacks', async () => {
      const user = userEvent.setup();
      const mockSubmitSanitized = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitSanitized} />
        </TestWrapper>
      );

      const maliciousTitle = '<script>alert("xss")</script>Announcement';
      const maliciousContent = '<img src="x" onerror="alert(\'xss\')" />Content';

      await user.type(screen.getByLabelText(/title/i), maliciousTitle);
      await user.type(screen.getByLabelText(/content/i), maliciousContent);
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmitSanitized).toHaveBeenCalledWith(
          expect.objectContaining({
            title: expect.not.stringContaining('<script>'),
            content: expect.not.stringContaining('<img')
          })
        );
      });
    });
  });
});

describe('TC-006: Authentication/Authorization', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('TC-006 Happy Path - Successful authentication and authorization flows', () => {
    it('should authenticate user with valid credentials and grant appropriate access', async () => {
      const user = userEvent.setup();
      const mockLogin = jest.fn().mockResolvedValue({
        user: { id: 'admin123', role: 'admin', email: 'admin@test.com' },
        token: 'valid-jwt-token'
      });

      const authContext = {
        user: null,
        isAuthenticated: false,
        login: mockLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Initial state - should show login prompt
      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();

      // Simulate successful login
      await act(async () => {
        await mockLogin('admin@test.com', 'valid-password');
      });

      // Re-render with authenticated context
      const authenticatedContext = {
        user: { id: 'admin123', role: 'admin', email: 'admin@test.com' },
        isAuthenticated: true,
        login: mockLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authenticatedContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Should now show the form
      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
    });

    it('should maintain user session and verify token validity across requests', async () => {
      const user = userEvent.setup();
      const mockTokenValidation = jest.fn().mockResolvedValue({ valid: true });
      const mockSubmitWithToken = jest.fn().mockResolvedValue({ success: true });

      const authContext = {
        user: { id: 'admin123', role: 'admin', token: 'valid-jwt-token' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn(),
        validateToken: mockTokenValidation
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmitWithToken} />
        </TestWrapper>
      );

      // Fill and submit form
      await user.type(screen.getByLabelText(/title/i), 'Session Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing session maintenance');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmitWithToken).toHaveBeenCalledWith(
          expect.objectContaining({
            title: 'Session Test',
            content: 'Testing session maintenance'
          })
        );
      });
    });

    it('should properly authorize admin users for all operations', async () => {
      const user = userEvent.setup();
      const adminContext = {
        user: { id: 'admin123', role: 'admin', permissions: ['create', 'edit', 'delete', 'moderate'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={adminContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Admin should have access to all form features
      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
      expect(screen.getByLabelText(/content/i)).toBeEnabled();
      
      // Check for admin-specific features
      const prioritySelect = screen.queryByLabelText(/priority/i);
      if (prioritySelect) {
        expect(prioritySelect).toBeEnabled();
      }

      await user.type(screen.getByLabelText(/title/i), 'Admin Announcement');
      await user.type(screen.getByLabelText(/content/i), 'Administrative announcement content');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmit).toHaveBeenCalled();
      });
    });

    it('should handle role-based permissions correctly for moderators', async () => {
      const user = userEvent.setup();
      const moderatorContext = {
        user: { id: 'mod123', role: 'moderator', permissions: ['create', 'edit', 'moderate'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={moderatorContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Moderator should have access to form but possibly limited features
      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
      expect(screen.getByLabelText(/content/i)).toBeEnabled();

      await user.type(screen.getByLabelText(/title/i), 'Moderator Announcement');
      await user.type(screen.getByLabelText(/content/i), 'Moderator announcement content');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmit).toHaveBeenCalledWith(
          expect.objectContaining({
            title: 'Moderator Announcement',
            content: 'Moderator announcement content'
          })
        );
      });
    });
  });

  describe('TC-006 Error Path - Authentication and authorization failures', () => {
    it('should reject authentication with invalid credentials', async () => {
      const user = userEvent.setup();
      const mockFailedLogin = jest.fn().mockRejectedValue(new Error('Invalid credentials'));

      const authContext = {
        user: null,
        isAuthenticated: false,
        login: mockFailedLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();

      // Attempt login with invalid credentials should fail
      await expect(mockFailedLogin('invalid@test.com', 'wrong-password')).rejects.toThrow('Invalid credentials');
    });

    it('should deny access to users without proper authorization', () => {
      const unauthorizedContext = {
        user: { id: 'user123', role: 'guest', permissions: ['read'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={unauthorizedContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/insufficient privileges/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should handle expired authentication tokens and force re-authentication', async () => {
      const user = userEvent.setup();
      const mockLogout = jest.fn();
      const expiredContext = {
        user: { id: 'admin123', role: 'admin', token: 'expired-token' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: mockLogout
      };

      const mockSubmitExpired = jest.fn().mockRejectedValue({
        response: { status: 401, data: { message: 'Token expired' } }
      });

      render(
        <TestWrapper authContext={expiredContext}>
          <AnnouncementForm onSubmit={mockSubmitExpired} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Expired Token Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing expired token handling');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/session expired.*please log in again/i)).toBeInTheDocument();
        expect(mockLogout).toHaveBeenCalled();
      });
    });

    it('should prevent unauthorized access attempts and log security violations', async () => {
      const user = userEvent.setup();
      const mockSecurityLog = jest.fn();
      const maliciousContext = {
        user: { id: 'hacker123', role: 'user' },
        isAuthenticated: false, // Inconsistent state - authenticated user but not marked as authenticated
        login: jest.fn(),
        logout: jest.fn(),
        logSecurityViolation: mockSecurityLog
      };

      render(
        <TestWrapper authContext={maliciousContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should handle network failures during authentication gracefully', async () => {
      const mockNetworkFailureLogin = jest.fn().mockRejectedValue(new Error('Network error'));

      const authContext = {
        user: null,
        isAuthenticated: false,
        login: mockNetworkFailureLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();

      // Network failure should be handled gracefully
      await expect(mockNetworkFailureLogin('user@test.com', 'password')).rejects.toThrow('Network error');
    });

    it('should validate user permissions for each protected operation', async () => {
      const user = userEvent.setup();
      const limitedUserContext = {
        user: { id: 'limited123', role: 'contributor', permissions: ['create'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      const mockRestrictedSubmit = jest.fn().mockRejectedValue({
        response: { status: 403, data: { message: 'Insufficient permissions for this operation' } }
      });

      render(
        <TestWrapper authContext={limitedUserContext}>
          <AnnouncementForm onSubmit={mockRestrictedSubmit} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Limited Access Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing permission restrictions');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/insufficient permissions/i)).toBeInTheDocument();
      });
    });

    it('should prevent session hijacking by validating session integrity', async () => {
      const user = userEvent.setup();
      const suspiciousContext = {
        user: { id: 'admin123', role: 'admin', sessionId: 'hijacked-session' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      const mockHijackingDetection = jest.fn().mockRejectedValue({
        response: { status: 403, data: { message: 'Session integrity violation detected' } }
      });

      render(
        <TestWrapper authContext={suspiciousContext}>
          <AnnouncementForm onSubmit={mockHijackingDetection} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Hijacking Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing session hijacking prevention');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/security violation detected/i)).toBeInTheDocument();
      });
    });
  });
});