// Form Implementation
class ContactForm {
  constructor(formElement) {
    this.form = formElement;
    this.submitButton = formElement.querySelector('#submit-btn');
    this.resetButton = formElement.querySelector('#reset-btn');
    this.fields = {
      name: formElement.querySelector('#name'),
      email: formElement.querySelector('#email'),
      message: formElement.querySelector('#message'),
      phone: formElement.querySelector('#phone'),
      category: formElement.querySelector('#category'),
      priority: formElement.querySelector('#priority')
    };
    
    // Synchronized enum values with backend
    this.enums = {
      category: ['general', 'support', 'sales', 'billing', 'technical'],
      priority: ['low', 'medium', 'high', 'urgent']
    };
    
    this.init();
  }

  init() {
    this.validateEnums();
    this.bindEvents();
    this.validateForm();
  }

  async validateEnums() {
    try {
      // Validate enum values against backend
      const backendEnums = await this.fetchBackendEnums();
      
      if (backendEnums.category && 
          JSON.stringify(this.enums.category.sort()) !== JSON.stringify(backendEnums.category.sort())) {
        console.warn('Category enum values mismatch with backend');
      }
      
      if (backendEnums.priority && 
          JSON.stringify(this.enums.priority.sort()) !== JSON.stringify(backendEnums.priority.sort())) {
        console.warn('Priority enum values mismatch with backend');
      }
    } catch (error) {
      console.warn('Could not validate enums against backend:', error);
    }
  }

  async fetchBackendEnums() {
    // Mock API call to fetch enum values from backend
    return new Promise((resolve) => {
      setTimeout(() => {
        resolve({
          category: ['general', 'support', 'sales', 'billing', 'technical'],
          priority: ['low', 'medium', 'high', 'urgent']
        });
      }, 100);
    });
  }

  bindEvents() {
    // Real-time validation on input
    Object.values(this.fields).forEach(field => {
      if (field) {
        field.addEventListener('input', () => {
          this.validateField(field);
          this.validateForm();
        });
        
        field.addEventListener('blur', () => {
          this.validateField(field);
        });
      }
    });

    // Form submission
    this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    
    // Reset functionality
    this.resetButton.addEventListener('click', () => this.handleReset());
  }

  validateField(field) {
    const errorElement = document.getElementById(`${field.name}-error`);
    this.clearFieldError(field);

    if (!field.validity.valid) {
      let errorMessage = '';
      
      if (field.validity.valueMissing) {
        errorMessage = `${this.getFieldLabel(field)} is required.`;
      } else if (field.validity.tooShort) {
        errorMessage = `${this.getFieldLabel(field)} must be at least ${field.minLength} characters.`;
      } else if (field.validity.tooLong) {
        errorMessage = `${this.getFieldLabel(field)} must be no more than ${field.maxLength} characters.`;
      } else if (field.validity.typeMismatch) {
        errorMessage = `Please enter a valid ${field.type === 'email' ? 'email address' : field.type}.`;
      } else if (field.validity.patternMismatch) {
        if (field.name === 'name') {
          errorMessage = 'Name can only contain letters and spaces.';
        } else if (field.name === 'phone') {
          errorMessage = 'Please enter a valid phone number.';
        }
      }
      
      this.showFieldError(field, errorMessage);
      return false;
    }
    
    // Validate enum fields
    if (field.name === 'category' && !this.enums.category.includes(field.value)) {
      this.showFieldError(field, 'Please select a valid category.');
      return false;
    }
    
    if (field.name === 'priority' && !this.enums.priority.includes(field.value)) {
      this.showFieldError(field, 'Please select a valid priority.');
      return false;
    }
    
    return true;
  }

  validateForm() {
    const isValid = this.form.checkValidity();
    this.submitButton.disabled = !isValid;
    return isValid;
  }

  showFieldError(field, message) {
    const errorElement = document.getElementById(`${field.name}-error`);
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.style.display = 'block';
      field.setAttribute('aria-invalid', 'true');
      field.classList.add('error');
    }
  }

  clearFieldError(field) {
    const errorElement = document.getElementById(`${field.name}-error`);
    if (errorElement) {
      errorElement.textContent = '';
      errorElement.style.display = 'none';
      field.setAttribute('aria-invalid', 'false');
      field.classList.remove('error');
    }
  }

  getFieldLabel(field) {
    const label = this.form.querySelector(`label[for="${field.id}"]`);
    return label ? label.textContent.replace('*', '').trim() : field.name;
  }

  async handleSubmit(e) {
    e.preventDefault();
    
    if (!this.validateForm()) {
      const firstInvalidField = this.form.querySelector(':invalid');
      if (firstInvalidField) {
        firstInvalidField.focus();
      }
      return;
    }

    try {
      this.setSubmittingState(true);
      
      const formData = new FormData(this.form);
      const response = await this.submitFormData(formData);
      
      if (response.success) {
        this.handleSubmitSuccess(response);
      } else {
        throw new Error(response.message || 'Submission failed');
      }
    } catch (error) {
      this.handleSubmitError(error);
    } finally {
      this.setSubmittingState(false);
    }
  }

  async submitFormData(formData) {
    // Mock API call - replace with actual endpoint
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        // Simulate random success/failure for testing
        if (Math.random() > 0.1) {
          resolve({ success: true, id: Math.random().toString(36).substr(2, 9) });
        } else {
          reject(new Error('Network error'));
        }
      }, 1000);
    });
  }

  setSubmittingState(isSubmitting) {
    this.submitButton.disabled = isSubmitting;
    this.submitButton.textContent = isSubmitting ? 'Submitting...' : 'Submit';
    
    // Disable all form fields during submission
    Object.values(this.fields).forEach(field => {
      if (field) {
        field.disabled = isSubmitting;
      }
    });
  }

  handleSubmitSuccess(response) {
    // Show success message
    const successMessage = document.createElement('div');
    successMessage.className = 'success-message';
    successMessage.textContent = 'Thank you! Your message has been sent successfully.';
    successMessage.setAttribute('role', 'alert');
    
    this.form.insertBefore(successMessage, this.form.firstChild);
    
    // Reset form
    this.handleReset();
    
    // Remove success message after 5 seconds
    setTimeout(() => {
      if (successMessage.parentNode) {
        successMessage.parentNode.removeChild(successMessage);
      }
    }, 5000);
  }

  handleSubmitError(error) {
    // Show error message
    const errorMessage = document.createElement('div');
    errorMessage.className = 'form-error-message';
    errorMessage.textContent = `Error: ${error.message}. Please try again.`;
    errorMessage.setAttribute('role', 'alert');
    
    this.form.insertBefore(errorMessage, this.form.firstChild);
    
    // Remove error message after 5 seconds
    setTimeout(() => {
      if (errorMessage.parentNode) {
        errorMessage.parentNode.removeChild(errorMessage);
      }
    }, 5000);
  }

  handleReset() {
    this.form.reset();
    
    // Clear all error messages
    Object.values(this.fields).forEach(field => {
      if (field) {
        this.clearFieldError(field);
      }
    });
    
    // Re-validate form state
    this.validateForm();
  }
}

// Global functions for backward compatibility with tests
window.validateForm = function(form) {
  return form.checkValidity();
};

window.showFieldError = function(field, message) {
  const errorElement = document.getElementById(`${field.name}-error`);
  if (errorElement) {
    errorElement.textContent = message;
    errorElement.style.display = 'block';
    field.setAttribute('aria-invalid', 'true');
    field.classList.add('error');
  }
};

window.clearFieldError = function(field) {
  const errorElement = document.getElementById(`${field.name}-error`);
  if (errorElement) {
    errorElement.textContent = '';
    errorElement.style.display = 'none';
    field.setAttribute('aria-invalid', 'false');
    field.classList.remove('error');
  }
};

