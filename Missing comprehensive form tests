        mockAPI.submit.mockRejectedValue(error);
      },
      
      reset: () => {
        mockAPI.submit.mockReset();
      }
    };

    beforeEach(() => {
      mockAPI.reset();
    });

    test('should handle network connectivity errors', async () => {
      // Arrange
      mockAPI.simulateNetworkError();
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = 'Test message content';

      // Act & Assert
      await expect(mockAPI.submit({
        name: nameInput.value,
        email: emailInput.value,
        message: messageInput.value
      })).rejects.toThrow('Network request failed');
    });

    test('should handle server errors (500, 502, 503)', async () => {
      const serverErrors = [500, 502, 503, 504];
      
      for (const statusCode of serverErrors) {
        // Arrange
        mockAPI.simulateServerError(statusCode);
        
        // Act & Assert
        await expect(mockAPI.submit({ test: 'data' })).rejects.toMatchObject({
          message: 'Server error',
          status: statusCode
        });
        
        mockAPI.reset();
      }
    });

    test('should handle validation errors from server', async () => {
      // Arrange
      mockAPI.simulateValidationError();
      
      // Act & Assert
      await expect(mockAPI.submit({
        name: 'Invalid<script>',
        email: 'invalid-email'
      })).rejects.toMatchObject({
        message: 'Validation failed',
        status: 422,
        response: {
          data: {
            errors: {
              email: expect.arrayContaining(['Invalid email format']),
              name: expect.arrayContaining(['Name contains invalid characters'])
            }
          }
        }
      });
    });

    test('should handle rate limiting errors', async () => {
      // Arrange
      mockAPI.simulateRateLimitError();
      
      // Act & Assert
      await expect(mockAPI.submit({ test: 'data' })).rejects.toMatchObject({
        message: 'Too many requests',
        status: 429,
        response: {
          headers: { 'retry-after': '60' }
        }
      });
    });

    test('should handle authentication errors', async () => {
      // Arrange
      mockAPI.simulateAuthenticationError();
      
      // Act & Assert
      await expect(mockAPI.submit({ test: 'data' })).rejects.toMatchObject({
        message: 'Authentication required',
        status: 401
      });
    });

    test('should handle request timeout errors', async () => {
      // Arrange
      mockAPI.simulateTimeoutError();
      
      // Act & Assert
      await expect(mockAPI.submit({ test: 'data' })).rejects.toMatchObject({
        message: 'Request timeout',
        code: 'ECONNABORTED',
        timeout: 5000
      });
    });

    test('should handle security policy violations', async () => {
      // Arrange
      mockAPI.simulateSecurityError();
      
      // Act & Assert
      await expect(mockAPI.submit({
        name: '<script>alert("xss")</script>',
        message: 'DROP TABLE users;'
      })).rejects.toMatchObject({
        message: 'Security validation failed',
        status: 403,
        response: {
          data: {
            code: 'SECURITY_VIOLATION'
          }
        }
      });
    });

    test('should prevent submission when name field is empty', () => {
      // Arrange
      nameInput.value = '';
      emailInput.value = 'test@example.com';
      messageInput.value = 'Test message with adequate length';

      // Act & Assert
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.valueMissing).toBe(true);
      expect(form.checkValidity()).toBe(false);
    });

    test('should prevent submission when email field is empty', () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = '';
      messageInput.value = 'Test message with adequate length';

      // Act & Assert
      expect(emailInput.validity.valid).toBe(false);
      expect(emailInput.validity.valueMissing).toBe(true);
      expect(form.checkValidity()).toBe(false);
    });

    test('should prevent submission when message field is empty', () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = '';

      // Act & Assert
      expect(messageInput.validity.valid).toBe(false);
      expect(messageInput.validity.valueMissing).toBe(true);
      expect(form.checkValidity()).toBe(false);
    });

    test('should reject invalid email formats', () => {
      // Arrange & Act
      const invalidEmails = [
        'invalid-email',
        '@example.com',
        'test@',
        'test.com',
        'user@',
        '@domain.com',
        'user..double.dot@domain.com',
        'user@domain',
        ''
      ];
      
      invalidEmails.forEach(invalidEmail => {
        emailInput.value = invalidEmail;
        
        // Assert
        expect(emailInput.validity.valid).toBe(false);
        if (invalidEmail === '') {
          expect(emailInput.validity.valueMissing).toBe(true);
        } else {
          expect(emailInput.validity.typeMismatch).toBe(true);
        }
      });
    });

    test('should validate name field length constraints', () => {
      // Test minimum length
      nameInput.value = 'A'; // Too short
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.tooShort).toBe(true);

      // Test maximum length
      nameInput.value = 'A'.repeat(VALIDATION_CONSTRAINTS.NAME.MAX_LENGTH + 1); // Too long
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.tooLong).toBe(true);

      // Test invalid characters
      nameInput.value = 'John123'; // Contains numbers
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.patternMismatch).toBe(true);
    });

    test('should validate message field length constraints', () => {
      // Test minimum length
      messageInput.value = 'Short'; // Too short
      expect(messageInput.validity.valid).toBe(false);
      expect(messageInput.validity.tooShort).toBe(true);

      // Test maximum length
      messageInput.value = 'A'.repeat(VALIDATION_CONSTRAINTS.MESSAGE.MAX_LENGTH + 1); // Too long
      expect(messageInput.validity.valid).toBe(false);
      expect(messageInput.validity.tooLong).toBe(true);
    });

    test('should validate phone number format when provided', () => {
      // Arrange
      const phoneInput = document.getElementById('phone');
      const invalidPhones = [
        'invalid-phone',
        '++1234567890',
        '123-456-7890',
        'abc123def',
        '0123456789012345678' // Too long
      ];

      invalidPhones.forEach(phone => {
        // Act
        phoneInput.value = phone;
        
        // Assert
        expect(phoneInput.validity.valid).toBe(false);
        expect(phoneInput.validity.patternMismatch).toBe(true);
      });
    });

    test('should prevent submission when all fields are empty', () => {
