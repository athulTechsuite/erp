    describe('Error Path', () => {
      it('should handle database connection pool exhaustion gracefully', async () => {
        const concurrentRequests = 200;
        const connectionError = new Error('Too many connections');
        
        // Simulate connection pool exhaustion after 100 requests
        let callCount = 0;
        mockDb.create.callsFake(() => {
          callCount++;
          if (callCount > 100) {
            return Promise.reject(connectionError);
          }
          return Promise.resolve({ id: callCount, title: 'Test' });
        });

        const promises = Array.from({ length: concurrentRequests }, () =>
          announcementManager.createAnnouncement({ title: 'Test' })
            .catch(err => ({ error: err.message }))
        );

        const results = await Promise.all(promises);
        
        const successfulRequests = results.filter(r => !r.error).length;
        const failedRequests = results.filter(r => r.error).length;

        expect(successfulRequests).to.equal(100);
        expect(failedRequests).to.equal(100);
        expect(failedRequests).to.be.greaterThan(0);
      });

      it('should handle timeout errors during high load', async () => {
        const timeoutError = new Error('Query timeout');
        const longRunningQuery = new Promise((_, reject) => {
          setTimeout(() => reject(timeoutError), 6000); // 6 second timeout
        });

        mockDb.findAll.returns(longRunningQuery);

        const startTime = Date.now();
        
        try {
          await announcementManager.getAllAnnouncements();
          expect.fail('Should have thrown timeout error');
        } catch (error) {
          const endTime = Date.now();
          const executionTime = endTime - startTime;
          
          expect(error.message).to.equal('Query timeout');
          expect(executionTime).to.be.at.least(6000);
        }
