      mockAuthService.validateToken.mockResolvedValue({
        valid: true,
        decoded: {
          userId: 1,
          username: 'testuser',
          role: 'admin',
          iat: Math.floor(Date.now() / 1000),
          exp: Math.floor(Date.now() / 1000) + 3600
        }
