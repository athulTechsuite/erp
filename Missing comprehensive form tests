    window.validateForm = jest.fn((formData) => {
      // Apply security validation to all inputs
      const sanitizedData = {};
      for (const [key, value] of Object.entries(formData)) {
        const sanitized = SecurityValidator.sanitizeInput(value);
        if (!SecurityValidator.validateAgainstXSS(value) || 
            !SecurityValidator.validateAgainstSQLInjection(value)) {
          throw new Error(`Security validation failed for field: ${key}`);
        }
        sanitizedData[key] = sanitized;
      }
      return sanitizedData;
    });
    
    window.showFieldError = jest.fn();
    window.clearFieldError = jest.fn();
  });

