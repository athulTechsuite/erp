const { test, expect } = require('@playwright/test');

// TC-001: Admin can create announcements
test.describe('TC-001: Admin can create announcements', () => {
  test('happy path - admin successfully creates announcement', async ({ page }) => {
    // Login as admin
    await page.goto('/admin/login');
    await page.fill('#username', 'admin');
    await page.fill('#password', 'password');
    await page.click('#login-btn');
    
    // Navigate to announcements
    await page.goto('/admin/announcements');
    await page.click('#create-announcement-btn');
    
    // Fill announcement form
    await page.fill('#title', 'Test Announcement');
    await page.fill('#content', 'This is a test announcement content');
    await page.selectOption('#priority', 'high');
    
    // Submit announcement
    await page.click('#submit-announcement');
    
    // Verify success
    await expect(page.locator('.success-message')).toBeVisible();
    await expect(page.locator('.announcement-title')).toContainText('Test Announcement');
  });

  test('error path - admin fails to create announcement with missing required fields', async ({ page }) => {
    // Login as admin
    await page.goto('/admin/login');
    await page.fill('#username', 'admin');
    await page.fill('#password', 'password');
    await page.click('#login-btn');
    
    // Navigate to announcements
    await page.goto('/admin/announcements');
    await page.click('#create-announcement-btn');
    
    // Submit without filling required fields
    await page.click('#submit-announcement');
    
    // Verify error handling
    await expect(page.locator('.error-message')).toBeVisible();
    await expect(page.locator('.field-error')).toContainText('Title is required');
  });
});

// TC-003: Announcements display on dashboard
test.describe('TC-003: Announcements display on dashboard', () => {
  test('happy path - announcements display correctly on dashboard', async ({ page }) => {
    // Create test announcement first
    await page.goto('/admin/announcements');
    await page.fill('#admin-username', 'admin');
    await page.fill('#admin-password', 'password');
    await page.click('#admin-login');
    
    await page.click('#create-announcement-btn');
    await page.fill('#title', 'Dashboard Test Announcement');
    await page.fill('#content', 'Test content for dashboard');
    await page.click('#submit-announcement');
    
    // Navigate to dashboard
    await page.goto('/dashboard');
    
    // Verify announcement displays
    await expect(page.locator('.announcements-section')).toBeVisible();
    await expect(page.locator('.announcement-item')).toContainText('Dashboard Test Announcement');
    await expect(page.locator('.announcement-content')).toContainText('Test content for dashboard');
