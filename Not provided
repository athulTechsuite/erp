          title: `Bulk Announcement ${index}`,
          content: `Content for announcement ${index}`,
          priority: 'low'
        }));
        
        const expectedResults = bulkData.map((item, index) => ({ id: index + 1, ...item }));
        mockDb.bulkCreate.resolves(expectedResults);

        const startTime = Date.now();
        const result = await announcementManager.bulkCreateAnnouncements(bulkData);
        const endTime = Date.now();
        const executionTime = endTime - startTime;

        expect(result).to.have.length(1000);
        expect(executionTime).to.be.below(3000); // Should complete within 3 seconds
        expect(mockDb.bulkCreate.calledOnceWith(bulkData)).to.be.true;
      });

