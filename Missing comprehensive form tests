// Validation configuration constants
const VALIDATION_CONSTRAINTS = {
  NAME: {
    MIN_LENGTH: 2,
    MAX_LENGTH: 50
  },
  EMAIL: {
    MAX_LENGTH: 100
  },
  MESSAGE: {
    MIN_LENGTH: 10,
    MAX_LENGTH: 500
  }
};

describe('TC-003: Form validation and submission', () => {
  let form, submitButton, nameInput, emailInput, messageInput;

  beforeEach(() => {
    // Setup form elements with comprehensive validation attributes
    document.body.innerHTML = `
      <form id="contact-form" novalidate>
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            minlength="${VALIDATION_CONSTRAINTS.NAME.MIN_LENGTH}" 
            maxlength="${VALIDATION_CONSTRAINTS.NAME.MAX_LENGTH}"
            pattern="^[a-zA-Z\u00C0-\u00FF\s'\-]+$"
            aria-describedby="name-error"
          >
          <div id="name-error" class="error-message" role="alert"></div>
        </div>
        
        <div class="form-group">
          <label for="email">Email Address *</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            maxlength="${VALIDATION_CONSTRAINTS.EMAIL.MAX_LENGTH}"
            aria-describedby="email-error"
          >
          <div id="email-error" class="error-message" role="alert"></div>
        </div>
        
        <div class="form-group">
          <label for="message">Message *</label>
          <textarea 
            id="message" 
            name="message" 
            required 
            minlength="${VALIDATION_CONSTRAINTS.MESSAGE.MIN_LENGTH}" 
            maxlength="${VALIDATION_CONSTRAINTS.MESSAGE.MAX_LENGTH}"
            aria-describedby="message-error"
          ></textarea>
          <div id="message-error" class="error-message" role="alert"></div>
        </div>
        
        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone"
            pattern="^[\+]?[1-9][\d]{0,15}$"
            aria-describedby="phone-error"
          >
          <div id="phone-error" class="error-message" role="alert"></div>
        </div>
        
        <button type="submit" id="submit-btn" disabled>Submit</button>
        <button type="reset" id="reset-btn">Reset</button>
      </form>
    `;
    
    form = document.getElementById('contact-form');
    submitButton = document.getElementById('submit-btn');
    nameInput = document.getElementById('name');
    emailInput = document.getElementById('email');
    messageInput = document.getElementById('message');
    
    // Mock form validation handler
    window.validateForm = jest.fn();
    window.showFieldError = jest.fn();
    window.clearFieldError = jest.fn();
  });

  afterEach(() => {
    document.body.innerHTML = '';
    jest.clearAllMocks();
  });

  // Happy path tests
  describe('Happy path - valid form submission', () => {
    test('should successfully submit form with valid data', async () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = 'This is a test message with sufficient length';

      const mockSubmitHandler = jest.fn((e) => {
        e.preventDefault();
        return Promise.resolve({ success: true, id: '12345' });
      });
      form.addEventListener('submit', mockSubmitHandler);

      // Act
      const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
      form.dispatchEvent(submitEvent);

      // Assert
      expect(mockSubmitHandler).toHaveBeenCalledTimes(1);
      expect(form.checkValidity()).toBe(true);
    });

    test('should validate email format correctly with various valid formats', () => {
      // Arrange
      const validEmails = [
        'user@domain.com',
        'test.email@example.org',
        'user+tag@domain.co.uk',
        'firstname.lastname@company.com'
      ];

      validEmails.forEach(email => {
        // Act
        emailInput.value = email;
        
        // Assert
        expect(emailInput.validity.valid).toBe(true);
        expect(emailInput.validity.typeMismatch).toBe(false);
      });
    });

    test('should accept all required fields when properly filled', () => {
      // Arrange
      nameInput.value = 'Jane Smith';
      emailInput.value = 'jane@test.com';
      messageInput.value = 'This is a comprehensive test message';

      // Act & Assert
      expect(nameInput.validity.valid).toBe(true);
      expect(emailInput.validity.valid).toBe(true);
      expect(messageInput.validity.valid).toBe(true);
      expect(form.checkValidity()).toBe(true);
    });

    test('should validate optional phone number when provided', () => {
      // Arrange
      const phoneInput = document.getElementById('phone');
      const validPhones = ['+1234567890', '1234567890', '+44207123456'];

      validPhones.forEach(phone => {
        // Act
        phoneInput.value = phone;
        
        // Assert
        expect(phoneInput.validity.valid).toBe(true);
      });
    });

    test('should enable submit button when form is valid', () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = 'Valid message content here';

      // Act
      const inputEvent = new Event('input', { bubbles: true });
      nameInput.dispatchEvent(inputEvent);
      emailInput.dispatchEvent(inputEvent);
      messageInput.dispatchEvent(inputEvent);

      // Assert (would need actual validation logic implementation)
      expect(form.checkValidity()).toBe(true);
    });
  });

  // Error path tests
  describe('Error path - invalid form submission', () => {
    test('should prevent submission when name field is empty', () => {
      // Arrange
      nameInput.value = '';
      emailInput.value = 'test@example.com';
      messageInput.value = 'Test message with adequate length';

      // Act & Assert
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.valueMissing).toBe(true);
      expect(form.checkValidity()).toBe(false);
    });

    test('should prevent submission when email field is empty', () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = '';
      messageInput.value = 'Test message with adequate length';

      // Act & Assert
      expect(emailInput.validity.valid).toBe(false);
      expect(emailInput.validity.valueMissing).toBe(true);
      expect(form.checkValidity()).toBe(false);
    });

    test('should prevent submission when message field is empty', () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = '';

      // Act & Assert
      expect(messageInput.validity.valid).toBe(false);
      expect(messageInput.validity.valueMissing).toBe(true);
      expect(form.checkValidity()).toBe(false);
    });

    test('should reject invalid email formats', () => {
      // Arrange & Act
      const invalidEmails = [
        'invalid-email',
        '@example.com',
        'test@',
        'test.com',
        'user@',
        '@domain.com',
        'user..double.dot@domain.com',
        'user@domain',
        ''
      ];
      
      invalidEmails.forEach(invalidEmail => {
        emailInput.value = invalidEmail;
        
        // Assert
        expect(emailInput.validity.valid).toBe(false);
        if (invalidEmail === '') {
          expect(emailInput.validity.valueMissing).toBe(true);
        } else {
          expect(emailInput.validity.typeMismatch).toBe(true);
        }
      });
    });

    test('should validate name field length constraints', () => {
      // Test minimum length
      nameInput.value = 'A'; // Too short
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.tooShort).toBe(true);

      // Test maximum length
      nameInput.value = 'A'.repeat(VALIDATION_CONSTRAINTS.NAME.MAX_LENGTH + 1); // Too long
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.tooLong).toBe(true);

      // Test invalid characters
      nameInput.value = 'John123'; // Contains numbers
      expect(nameInput.validity.valid).toBe(false);
      expect(nameInput.validity.patternMismatch).toBe(true);
    });

    test('should validate message field length constraints', () => {
      // Test minimum length
      messageInput.value = 'Short'; // Too short
      expect(messageInput.validity.valid).toBe(false);
      expect(messageInput.validity.tooShort).toBe(true);

      // Test maximum length
      messageInput.value = 'A'.repeat(VALIDATION_CONSTRAINTS.MESSAGE.MAX_LENGTH + 1); // Too long
      expect(messageInput.validity.valid).toBe(false);
      expect(messageInput.validity.tooLong).toBe(true);
    });

    test('should validate phone number format when provided', () => {
      // Arrange
      const phoneInput = document.getElementById('phone');
      const invalidPhones = [
        'invalid-phone',
        '++1234567890',
        '123-456-7890',
        'abc123def',
        '0123456789012345678' // Too long
      ];

      invalidPhones.forEach(phone => {
        // Act
        phoneInput.value = phone;
        
        // Assert
        expect(phoneInput.validity.valid).toBe(false);
        expect(phoneInput.validity.patternMismatch).toBe(true);
      });
    });

    test('should prevent submission when all fields are empty', () => {
      // Arrange
      nameInput.value = '';
      emailInput.value = '';
      messageInput.value = '';

      const mockSubmitHandler = jest.fn((e) => e.preventDefault());
      form.addEventListener('submit', mockSubmitHandler);

      // Act
      const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
      form.dispatchEvent(submitEvent);

      // Assert
      expect(form.checkValidity()).toBe(false);
      expect(nameInput.validity.valueMissing).toBe(true);
      expect(emailInput.validity.valueMissing).toBe(true);
      expect(messageInput.validity.valueMissing).toBe(true);
    });

    test('should handle form submission errors gracefully', async () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = 'This is a test message';

      const mockSubmitHandler = jest.fn((e) => {
        e.preventDefault();
        throw new Error('Network error');
      });
      form.addEventListener('submit', mockSubmitHandler);

      // Act & Assert
      expect(() => {
        const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
        form.dispatchEvent(submitEvent);
      }).toThrow('Network error');
    });
  });

  // Edge cases and accessibility tests
  describe('Edge cases and accessibility', () => {
    test('should maintain focus on invalid field after submission attempt', () => {
      // Arrange
      nameInput.value = '';
      emailInput.value = 'valid@email.com';
      messageInput.value = 'Valid message content';

      // Act
      const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
      form.dispatchEvent(submitEvent);

      // Assert
      expect(form.checkValidity()).toBe(false);
      // In real implementation, invalid field should receive focus
    });

    test('should display appropriate error messages for invalid fields', () => {
      // Arrange
      nameInput.value = '';
      const errorDiv = document.getElementById('name-error');

      // Act
      const blurEvent = new Event('blur', { bubbles: true });
      nameInput.dispatchEvent(blurEvent);

      // Assert
      expect(nameInput.validity.valueMissing).toBe(true);
      expect(errorDiv.getAttribute('role')).toBe('alert');
    });

    test('should reset form fields when reset button is clicked', () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = 'Test message';
      const resetButton = document.getElementById('reset-btn');

      // Act
      resetButton.click();

      // Assert
      expect(nameInput.value).toBe('');
      expect(emailInput.value).toBe('');
      expect(messageInput.value).toBe('');
    });

    test('should handle special characters in text inputs', () => {
      // Arrange
      const specialCharNames = [
        'José María',
        'François',
        'Müller',
        'O\'Brien',
        'Mary-Jane'
      ];

      specialCharNames.forEach(name => {
        // Act
        nameInput.value = name;
        
        // Assert - should be valid for names with accents and hyphens
        expect(nameInput.validity.valid).toBe(true);
        expect(nameInput.validity.patternMismatch).toBe(false);
      });
    });

    test('should validate form state changes during user interaction', () => {
      // Arrange
      let formValidState = false;

      const validateFormState = () => {
        formValidState = form.checkValidity();
        submitButton.disabled = !formValidState;
      };

      // Act - simulate user filling form step by step
      nameInput.value = 'John';
      validateFormState();
      expect(formValidState).toBe(false); // Email and message still empty

      emailInput.value = 'john@example.com';
      validateFormState();
      expect(formValidState).toBe(false); // Message still empty

      messageInput.value = 'Complete test message content';
      validateFormState();
      expect(formValidState).toBe(true); // All required fields filled
    });

    test('should handle form submission with loading state and complete the validation scenario properly', async () => {
      // Arrange
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      messageInput.value = 'Test message content';

      let isSubmitting = false;
      const mockSubmitHandler = jest.fn(async (e) => {
        e.preventDefault();
        isSubmitting = true;
        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';
        
        // Simulate async operation
        await new Promise(resolve => setTimeout(resolve, 100));
        
        isSubmitting = false;
        submitButton.disabled = false;
        submitButton.textContent = 'Submit';
        
        return { success: true, message: 'Form submitted successfully' };
      });

      form.addEventListener('submit', mockSubmitHandler);

      // Act
      const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
      const submissionPromise = form.dispatchEvent(submitEvent);

      // Assert initial state during submission
      expect(mockSubmitHandler).toHaveBeenCalledTimes(1);
      expect(submitButton.disabled).toBe(true);
      expect(submitButton.textContent).toBe('Submitting...');
      
      // Wait for async operation to complete
      await new Promise(resolve => setTimeout(resolve, 150));
      
      // Assert final state after submission
      expect(submitButton.disabled).toBe(false);
      expect(submitButton.textContent).toBe('Submit');
      expect(form.checkValidity()).toBe(true);
    });
  });
});