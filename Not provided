        const oversizedData = Array.from({ length: 100000 }, () => ({
          title: 'Large announcement with very long content'.repeat(1000),
          content: 'Content'.repeat(10000)
        }));

        mockDb.bulkCreate.rejects(memoryError);

        await expect(announcementManager.bulkCreateAnnouncements(oversizedData))
          .to.be.rejectedWith('Out of memory');
      });

      it('should handle deadlock scenarios in concurrent operations', async () => {
        const deadlockError = new Error('Deadlock detected');
        let operationCount = 0;

        // Simulate deadlock after multiple concurrent operations
        mockDb.update.callsFake(() => {
          operationCount++;
          if (operationCount > 5) {
            return Promise.reject(deadlockError);
          }
          return Promise.resolve({ id: 1, title: 'Updated' });
        });

        const concurrentUpdates = Array.from({ length: 10 }, () =>
          announcementManager.updateAnnouncement(1, { title: 'Updated' })
            .catch(err => ({ error: err.message }))
        );

        const results = await Promise.all(concurrentUpdates);
        const deadlockErrors = results.filter(r => r.error === 'Deadlock detected');

        expect(deadlockErrors.length).to.be.greaterThan(0);
      });

      it('should handle network latency issues during distributed load', async () => {
        const networkError = new Error('Network timeout');
        const delayedResponse = new Promise((resolve, reject) => {
          setTimeout(() => reject(networkError), 10000); // 10 second network delay
        });

        mockDb.findById.returns(delayedResponse);

        const timeoutPromise = new Promise((_, reject) => {
          setTimeout(() => reject(new Error('Operation timeout')), 5000);
        });

        try {
          await Promise.race([
            announcementManager.getAnnouncement(1),
            timeoutPromise
          ]);
          expect.fail('Should have timed out');
        } catch (error) {
          expect(error.message).to.equal('Operation timeout');
        }
      });

      it('should handle resource starvation under sustained load', async () => {
        const resourceError = new Error('Resource temporarily unavailable');
        let requestCount = 0;

        mockDb.create.callsFake(() => {
          requestCount++;
          // Simulate resource starvation after sustained load
          if (requestCount % 50 === 0) {
            return Promise.reject(resourceError);
          }
          return Promise.resolve({ id: requestCount, title: 'Test' });
        });

        const sustainedLoad = Array.from({ length: 300 }, () =>
          announcementManager.createAnnouncement({ title: 'Load test' })
            .catch(err => ({ error: err.message }))
        );

        const results = await Promise.all(sustainedLoad);
        const resourceErrors = results.filter(r => r.error === 'Resource temporarily unavailable');

        expect(resourceErrors.length).to.be.at.least(6); // Should have multiple resource errors
      });

      it('should handle cascading failures during peak load', async () => {
        const cascadingError = new Error('Service unavailable');
        let failureStarted = false;

        mockDb.findAll.callsFake(() => {
          // Simulate cascading failure after initial success
          if (!failureStarted) {
            failureStarted = true;
            return Promise.resolve([{ id: 1, title: 'Initial success' }]);
          }
          return Promise.reject(cascadingError);
        });

        const requests = Array.from({ length: 10 }, () =>
          announcementManager.getAllAnnouncements()
            .catch(err => ({ error: err.message }))
        );

        const results = await Promise.all(requests);
        const successfulRequests = results.filter(r => !r.error);
        const failedRequests = results.filter(r => r.error);

        expect(successfulRequests.length).to.equal(1);
        expect(failedRequests.length).to.equal(9);
        expect(failedRequests[0].error).to.equal('Service unavailable');
      });
    });
