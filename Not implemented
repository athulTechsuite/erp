  });

  describe('TC-006 Error Path - Authentication and authorization failures', () => {
    it('should reject authentication with invalid credentials', async () => {
      const user = userEvent.setup();
      const mockFailedLogin = jest.fn().mockRejectedValue(new Error('Invalid credentials'));

      const authContext = {
        user: null,
        isAuthenticated: false,
        login: mockFailedLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();

      // Attempt login with invalid credentials should fail
      await expect(mockFailedLogin('invalid@test.com', 'wrong-password')).rejects.toThrow('Invalid credentials');
    });

    it('should deny access to users without proper authorization', () => {
      const unauthorizedContext = {
        user: { id: 'user123', role: 'guest', permissions: ['read'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={unauthorizedContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/insufficient privileges/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should handle expired authentication tokens and force re-authentication', async () => {
      const user = userEvent.setup();
