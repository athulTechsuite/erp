      mockAuthService.enforceAccessControl.mockResolvedValue({
        accessGranted: true,
        policy: 'role_based_access_control',
        user: { id: 1, roles: ['admin'] },
        resource: { id: 'announcement-123', type: 'announcement', owner: 'user-456' },
        appliedRules: ['admin_full_access', 'resource_owner_access'],
        auditLog: {
          timestamp: '2023-12-01T10:00:00Z',
          action: 'access_granted',
          reason: 'admin_privileges'
        }
      });

      const result = await mockAuthService.enforceAccessControl({
        userId: 1,
        resource: { id: 'announcement-123', type: 'announcement' },
        action: 'update'
      });

      expect(result.accessGranted).toBe(true);
      expect(result.policy).toBe('role_based_access_control');
      expect(result.appliedRules).toContain('admin_full_access');
      expect(result.auditLog.action).toBe('access_granted');
    });

    it('TC-005: should successfully validate active user session with proper token management', async () => {
      mockAuthService.validateSession.mockResolvedValue({
        valid: true,
        session: {
          id: 'session-456',
          userId: 1,
          token: 'active-session-token',
          createdAt: '2023-12-01T08:00:00Z',
          lastActivity: '2023-12-01T10:00:00Z',
          expiresAt: '2023-12-01T18:00:00Z',
          ipAddress: '192.168.1.100',
          userAgent: 'Mozilla/5.0'
        },
        user: { id: 1, username: 'active_user', status: 'active' },
        remainingTime: 28800
      });

      const result = await mockAuthService.validateSession('active-session-token');

      expect(result.valid).toBe(true);
      expect(result.session.userId).toBe(1);
      expect(result.user.status).toBe('active');
      expect(result.remainingTime).toBe(28800);
      expect(result.session.ipAddress).toBe('192.168.1.100');
    });

    it('TC-005: should successfully logout user and cleanup session data', async () => {
      mockAuthService.logout.mockResolvedValue({
        success: true,
        userId: 1,
        sessionId: 'session-789',
        logoutTime: '2023-12-01T10:00:00Z',
        tokensInvalidated: ['auth-token-123', 'refresh-token-456'],
        cleanupCompleted: true
      });

      const result = await mockAuthService.logout({
        sessionId: 'session-789',
        invalidateAllSessions: false
      });

      expect(result.success).toBe(true);
      expect(result.userId).toBe(1);
      expect(result.tokensInvalidated).toHaveLength(2);
      expect(result.cleanupCompleted).toBe(true);
    });

    it('TC-005: should successfully handle role hierarchy and permission inheritance', async () => {
      mockUserService.getUserRoles.mockResolvedValue({
        user: { id: 4, username: 'hierarchy_user' },
        directRoles: ['content_editor'],
        inheritedRoles: ['user', 'content_viewer'],
        roleHierarchy: {
          content_editor: ['content_viewer', 'user'],
          content_viewer: ['user']
        },
        effectivePermissions: ['read', 'create_content', 'edit_own_content'],
        permissionSources: {
          read: ['user'],
          create_content: ['content_viewer'],
          edit_own_content: ['content_editor']
        }
      });

      const result = await mockUserService.getUserRoles(4);

      expect(result.directRoles).toContain('content_editor');
      expect(result.inheritedRoles).toContain('user');
      expect(result.inheritedRoles).toContain('content_viewer');
      expect(result.effectivePermissions).toContain('edit_own_content');
      expect(result.permissionSources.read).toContain('user');
    });
  });

  describe('Error path - Authentication and authorization failures', () => {
    it('TC-005: should handle authentication failure with invalid username', async () => {
      mockAuthService.authenticate.mockResolvedValue({
        success: false,
        error: 'User not found',
        code: 'USER_NOT_FOUND',
        details: {
          username: 'nonexistent_user',
          timestamp: '2023-12-01T10:00:00Z',
          attemptNumber: 1
        }
      });

      const result = await mockAuthService.authenticate({
        username: 'nonexistent_user',
        password: 'password123'
      });

      expect(result.success).toBe(false);
      expect(result.error).toBe('User not found');
      expect(result.code).toBe('USER_NOT_FOUND');
      expect(result.details.username).toBe('nonexistent_user');
    });

    it('TC-005: should handle authentication failure with incorrect password and track attempts', async () => {
      mockAuthService.authenticate.mockResolvedValue({
        success: false,
        error: 'Invalid password',
        code: 'INVALID_PASSWORD',
        failedAttempts: 3,
