  describe('Valid announcement form input scenarios', () => {
    test('TC-004: should accept valid announcement title', () => {
      const validTitle = 'Important Company Update';
      const result = validateAnnouncementTitle(validTitle);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });

    test('TC-004: should accept valid announcement content', () => {
      const validContent = 'This is a valid announcement content with proper formatting.';
      const result = validateAnnouncementContent(validContent);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });

    test('TC-004: should accept valid announcement category', () => {
      const validCategory = 'general';
      const result = validateAnnouncementCategory(validCategory);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });

    test('TC-004: should accept valid priority level', () => {
      const validPriority = 'high';
      const result = validateAnnouncementPriority(validPriority);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });
  });

  // Error path tests for announcement form
  describe('Invalid announcement form input scenarios', () => {
    test('TC-004: should reject null announcement title', () => {
      const invalidTitle = null;
      const result = validateAnnouncementTitle(invalidTitle);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Announcement title cannot be null');
    });

    test('TC-004: should reject undefined announcement content', () => {
      const invalidContent = undefined;
      const result = validateAnnouncementContent(invalidContent);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Announcement content is required');
    });

    test('TC-004: should reject empty announcement title', () => {
      const invalidTitle = '';
      const result = validateAnnouncementTitle(invalidTitle);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Announcement title cannot be empty');
    });

    test('TC-004: should reject invalid announcement category', () => {
      const invalidCategory = 'invalid-category';
      const result = validateAnnouncementCategory(invalidCategory);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Invalid announcement category');
    });

    test('TC-004: should reject XSS attempts in announcement content', () => {
      const maliciousContent = '<script>alert("xss")</script>Announcement content';
      const result = validateAnnouncementContent(maliciousContent);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Invalid characters detected in announcement content');
    });

    test('TC-004: should reject invalid priority level', () => {
      const invalidPriority = 'invalid-priority';
      const result = validateAnnouncementPriority(invalidPriority);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Invalid priority level');
    });
  });

  // Edge cases for announcement form
  describe('Announcement form edge case scenarios', () => {
    test('TC-004: should handle maximum length announcement title', () => {
      const maxLengthTitle = 'a'.repeat(201);
      const result = validateAnnouncementTitle(maxLengthTitle);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Announcement title exceeds maximum length (200 characters)');
    });

    test('TC-004: should handle maximum length announcement content', () => {
      const maxLengthContent = 'a'.repeat(5001);
      const result = validateAnnouncementContent(maxLengthContent);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Announcement content exceeds maximum length (5000 characters)');
    });

    test('TC-004: should handle whitespace-only announcement title', () => {
      const whitespaceTitle = '   ';
      const result = validateAnnouncementTitle(whitespaceTitle);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Announcement title cannot contain only whitespace');
    });

    test('TC-004: should handle minimum length validation for announcement content', () => {
