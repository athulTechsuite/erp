{
  "name": "erp-leave-management",
  "version": "1.0.0",
  "description": "Core ERP System with Leave Management for Small Companies",
  "main": "server.js",
  "scripts": {
    "start": "node -r dotenv/config server.js",
    "dev": "nodemon -r dotenv/config server.js",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "install:client": "cd client && npm install",
    "install:all": "npm install && npm run install:client",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "erp",
    "leave-management",
    "hr",
    "small-business",
    "employee-management",
    "dashboard",
    "announcements",
    "notifications"
  ],
  "author": "Development Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.32.1",
    "mysql2": "^3.6.0",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "moment": "^2.29.4",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "pdf-kit": "^0.13.0",
    "excel4node": "^1.8.2",
    "compression": "^1.7.4",
    "socket.io": "^4.7.2",
    "quill": "^1.3.7",
    "sanitize-html": "^2.11.0",
    "mime-types": "^2.1.35",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.46.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "sequelize-cli": "^6.6.1",
    "@types/jest": "^29.5.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/company/erp-leave-management.git"
  },
  "bugs": {
    "url": "https://github.com/company/erp-leave-management/issues"
  },
  "homepage": "https://github.com/company/erp-leave-management#readme"
}