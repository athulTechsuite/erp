// test_input_validation.js
// TC-004: Input validation and error handling test coverage

describe('TC-004: Input validation and error handling', () => {
  // Setup DOM elements for testing
  beforeEach(() => {
    document.body.innerHTML = `
      <div class="error-name" style="display: none;"></div>
      <div class="error-email" style="display: none;"></div>
      <input id="name-input" type="text" />
      <input id="email-input" type="email" />
      <form id="test-form">
        <input name="username" type="text" />
        <input name="email" type="email" />
      </form>
    `;
  });

  afterEach(() => {
    document.body.innerHTML = '';
  });

  // Happy path tests
  describe('Valid input scenarios', () => {
    test('TC-004: should accept valid string input', () => {
      const validInput = 'test string';
      const result = validateInput(validInput);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });

    test('TC-004: should accept valid numeric input', () => {
      const validInput = 123;
      const result = validateInput(validInput);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });

    test('TC-004: should accept valid email format', () => {
      const validEmail = 'test@example.com';
      const result = validateEmail(validEmail);
      expect(result.isValid).toBe(true);
      expect(result.error).toBeNull();
    });

    test('TC-004: should display no error messages for valid input', () => {
      const nameError = document.querySelector('.error-name');
      const emailError = document.querySelector('.error-email');
      
      expect(nameError).not.toBeNull();
      expect(emailError).not.toBeNull();
      expect(nameError.style.display).toBe('none');
      expect(emailError.style.display).toBe('none');
    });
  });

  // Error path tests
  describe('Invalid input scenarios', () => {
    test('TC-004: should reject null input', () => {
      const invalidInput = null;
      const result = validateInput(invalidInput);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Input cannot be null');
    });

    test('TC-004: should reject undefined input', () => {
      const invalidInput = undefined;
      const result = validateInput(invalidInput);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Input is required');
    });

    test('TC-004: should reject empty string input', () => {
      const invalidInput = '';
      const result = validateInput(invalidInput);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Input cannot be empty');
    });

    test('TC-004: should reject invalid email format', () => {
      const invalidEmail = 'invalid-email';
      const result = validateEmail(invalidEmail);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Invalid email format');
    });

    test('TC-004: should handle special characters properly', () => {
      const specialCharsInput = '<script>alert("test")</script>';
      const result = validateInput(specialCharsInput);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Invalid characters detected');
    });

    test('TC-004: should show error messages in DOM elements', () => {
      const nameError = document.querySelector('.error-name');
      const emailError = document.querySelector('.error-email');
      
      // Simulate showing errors
      nameError.textContent = 'Name is required';
      nameError.style.display = 'block';
      emailError.textContent = 'Invalid email format';
      emailError.style.display = 'block';
      
      expect(nameError.textContent).toBe('Name is required');
      expect(emailError.textContent).toBe('Invalid email format');
      expect(nameError.style.display).toBe('block');
      expect(emailError.style.display).toBe('block');
    });
  });

  // Edge cases
  describe('Edge case scenarios', () => {
    test('TC-004: should handle maximum length input', () => {
      const maxLengthInput = 'a'.repeat(1000);
      const result = validateInput(maxLengthInput);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Input exceeds maximum length');
    });

    test('TC-004: should handle whitespace-only input', () => {
      const whitespaceInput = '   ';
      const result = validateInput(whitespaceInput);
      expect(result.isValid).toBe(false);
      expect(result.error).toBe('Input cannot contain only whitespace');
    });

    test('TC-004: should handle various data types', () => {
      const testCases = [
        { input: [], expected: false, error: 'Invalid input type' },
        { input: {}, expected: false, error: 'Invalid input type' },
        { input: true, expected: true, error: null },
        { input: false, expected: true, error: null },
        { input: 0, expected: true, error: null }
      ];
      
      testCases.forEach(({ input, expected, error }) => {
        const result = validateInput(input);
        expect(result.isValid).toBe(expected);
        expect(result.error).toBe(error);
      });
    });

    test('TC-004: should validate email edge cases', () => {
      const emailTestCases = [
        { email: 'test@', expected: false },
        { email: '@example.com', expected: false },
        { email: 'test@example', expected: false },
        { email: 'test.email@example.co.uk', expected: true },
        { email: 'user+tag@example.com', expected: true },
        { email: 'test space@example.com', expected: false }
      ];

      emailTestCases.forEach(({ email, expected }) => {
        const result = validateEmail(email);
        expect(result.isValid).toBe(expected);
      });
    });

    test('TC-004: should handle DOM manipulation during validation', () => {
      const nameInput = document.querySelector('#name-input');
      const emailInput = document.querySelector('#email-input');
      const form = document.querySelector('#test-form');
      
      expect(nameInput).not.toBeNull();
      expect(emailInput).not.toBeNull();
      expect(form).not.toBeNull();
      
      // Test form validation
      nameInput.value = 'John Doe';
      emailInput.value = 'john@example.com';
      
      expect(validateInput(nameInput.value).isValid).toBe(true);
      expect(validateEmail(emailInput.value).isValid).toBe(true);
    });
  });

  // DOM Integration tests
  describe('DOM Integration scenarios', () => {
    test('TC-004: should properly interact with error display elements', () => {
      const nameError = document.querySelector('.error-name');
      const emailError = document.querySelector('.error-email');
      
      // Test error display functionality
      function showError(element, message) {
        element.textContent = message;
        element.style.display = 'block';
      }
      
      function hideError(element) {
        element.textContent = '';
        element.style.display = 'none';
      }
      
      // Show errors
      showError(nameError, 'Name validation failed');
      showError(emailError, 'Email validation failed');
      
      expect(nameError.textContent).toBe('Name validation failed');
      expect(emailError.textContent).toBe('Email validation failed');
      expect(nameError.style.display).toBe('block');
      expect(emailError.style.display).toBe('block');
      
      // Hide errors
      hideError(nameError);
      hideError(emailError);
      
      expect(nameError.textContent).toBe('');
      expect(emailError.textContent).toBe('');
      expect(nameError.style.display).toBe('none');
      expect(emailError.style.display).toBe('none');
    });

    test('TC-004: should validate form inputs and update error states', () => {
      const form = document.querySelector('#test-form');
      const nameError = document.querySelector('.error-name');
      const emailError = document.querySelector('.error-email');
      
      function validateForm(formData) {
        let isValid = true;
        const errors = [];
        
        // Validate username
        const usernameResult = validateInput(formData.username);
        if (!usernameResult.isValid) {
          nameError.textContent = usernameResult.error;
          nameError.style.display = 'block';
          isValid = false;
          errors.push('username');
        } else {
          nameError.style.display = 'none';
        }
        
        // Validate email
        const emailResult = validateEmail(formData.email);
        if (!emailResult.isValid) {
          emailError.textContent = emailResult.error;
          emailError.style.display = 'block';
          isValid = false;
          errors.push('email');
        } else {
          emailError.style.display = 'none';
        }
        
        return { isValid, errors };
      }
      
      // Test valid form data
      let result = validateForm({ username: 'testuser', email: 'test@example.com' });
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
      
      // Test invalid form data
      result = validateForm({ username: '', email: 'invalid-email' });
      expect(result.isValid).toBe(false);
      expect(result.errors).toContain('username');
      expect(result.errors).toContain('email');
    });
  });
});

/**
 * Input validation function with comprehensive type and content checking
 * Supports multiple input types and validates against common security risks
 * 
 * Implementation details:
 * - Performs null/undefined checks first to prevent runtime errors
 * - Uses strict type checking with typeof operator
 * - Implements trim() for whitespace validation to handle edge cases
 * - Uses includes() for basic XSS pattern detection
 * - Implements length validation with configurable maximum (999 chars)
 * - Returns consistent object structure with isValid boolean and error message
 * 
 * @param {*} input - The input value to validate (any type)
 * @returns {Object} - Validation result with isValid boolean and error message
 */
function validateInput(input) {
  // Handle null values explicitly to avoid TypeError
  if (input === null) {
    return { isValid: false, error: 'Input cannot be null' };
  }
  
  // Handle undefined values - required field validation
  if (input === undefined) {
    return { isValid: false, error: 'Input is required' };
  }
  
  // Handle empty string validation
  if (input === '') {
    return { isValid: false, error: 'Input cannot be empty' };
  }
  
  // Handle arrays and objects as invalid input types
  if (Array.isArray(input) || (typeof input === 'object' && input !== null)) {
    return { isValid: false, error: 'Invalid input type' };
  }
  
  // String-specific validations
  if (typeof input === 'string') {
    // Whitespace-only validation using trim()
    if (input.trim() === '') {
      return { isValid: false, error: 'Input cannot contain only whitespace' };
    }
    
    // Basic XSS protection - check for script tags
    if (input.includes('<script>')) {
      return { isValid: false, error: 'Invalid characters detected' };
    }
    
    // Length validation with configurable maximum
    if (input.length > 999) {
      return { isValid: false, error: 'Input exceeds maximum length' };
    }
  }
  
  // Valid input - passes all checks
  return { isValid: true, error: null };
}

/**
 * Email validation function using regex pattern matching
 * 
 * Implementation details:
 * - Uses comprehensive regex pattern for email format validation
 * - Pattern breakdown: /^[^\s@]+@[^\s@]+\.[^\s@]+$/
 *   - ^ : Start of string
 *   - [^\s@]+ : One or more characters that are not whitespace or @
 *   - @ : Literal @ symbol
 *   - [^\s@]+ : One or more characters that are not whitespace or @
 *   - \. : Literal dot (escaped)
 *   - [^\s@]+ : One or more characters that are not whitespace or @
 *   - $ : End of string
 * - Rejects emails with spaces, multiple @ symbols, or missing components
 * 
 * @param {string} email - The email string to validate
 * @returns {Object} - Validation result with isValid boolean and error message
 */
function validateEmail(email) {
  // Comprehensive email regex pattern
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  
  // Test email against regex pattern
  if (!emailRegex.test(email)) {
    return { isValid: false, error: 'Invalid email format' };
  }
  
  // Valid email format
  return { isValid: true, error: null };
}

// Additional helper functions for DOM manipulation and error handling
function displayValidationError(errorElement, message) {
  if (errorElement) {
    errorElement.textContent = message;
    errorElement.style.display = 'block';
    errorElement.setAttribute('role', 'alert');
  }
}

function clearValidationError(errorElement) {
  if (errorElement) {
    errorElement.textContent = '';
    errorElement.style.display = 'none';
    errorElement.removeAttribute('role');
  }
}

function validateFormField(fieldValue, fieldType, errorElement) {
  let result;
  
  switch (fieldType) {
    case 'email':
      result = validateEmail(fieldValue);
      break;
    default:
      result = validateInput(fieldValue);
  }
  
  if (result.isValid) {
    clearValidationError(errorElement);
  } else {
    displayValidationError(errorElement, result.error);
  }
  
  return result;
}

// Export functions for use in other modules
if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    validateInput,
    validateEmail,
    displayValidationError,
    clearValidationError,
    validateFormField
  };
}