# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_system
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_URL=postgresql://your_db_user:your_db_password@localhost:5432/erp_system

# Application Configuration
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication & Security
# IMPORTANT: Generate strong, unique secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WARNING: This JWT secret is for development only - MUST be replaced with a cryptographically secure secret in production
JWT_SECRET=dev_jwt_secret_replace_with_secure_random_string_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key
ENABLE_ROLE_BASED_ACCESS=true
SESSION_TIMEOUT_MINUTES=30

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@company.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@yourcompany.com

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Redis Configuration (for session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Default Admin Configuration
# WARNING: Set these securely in production, never use default passwords
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
# DEFAULT_ADMIN_PASSWORD should be set securely during deployment, not in this file
DEFAULT_COMPANY_NAME=Your Company Name

# Leave Management Configuration
DEFAULT_ANNUAL_LEAVE_DAYS=20
DEFAULT_SICK_LEAVE_DAYS=10
LEAVE_YEAR_START_MONTH=1

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Backup Configuration
BACKUP_PATH=./backups
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *

# Data Export Configuration
EXPORT_PATH=./exports
EXPORT_FORMATS=csv,xlsx,pdf
MAX_EXPORT_RECORDS=10000

# Financial Dashboard Configuration
ENABLE_FINANCIAL_DASHBOARD=true
FINANCIAL_YEAR_START_MONTH=4
DEFAULT_CURRENCY=USD
ENABLE_MULTI_CURRENCY=false

# UI Configuration
ENABLE_RESPONSIVE_DESIGN=true
MOBILE_BREAKPOINT=768
TABLET_BREAKPOINT=1024