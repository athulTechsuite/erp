const request = require('supertest');
const app = require('../src/app');
const { setupTestDatabase, cleanupTestDatabase } = require('./helpers/database');
const { createTestUser, createAdminUser } = require('./helpers/users');

describe('Announcement Management Tests', () => {
  let adminToken;
  let userToken;
  let testAnnouncement;

  beforeAll(async () => {
    await setupTestDatabase();
    const admin = await createAdminUser();
    const user = await createTestUser();
    adminToken = admin.token;
    userToken = user.token;
  });

  afterAll(async () => {
    await cleanupTestDatabase();
  });

  // TC-001: Announcement CRUD operations
  describe('TC-001: Announcement CRUD operations', () => {
    // Happy path tests
    describe('Happy path scenarios', () => {
      test('should create announcement successfully', async () => {
        const announcementData = {
          title: 'Test Announcement',
          content: 'This is a test announcement content',
          priority: 'high',
          active: true
        };

        const response = await request(app)
          .post('/api/announcements')
          .set('Authorization', `Bearer ${adminToken}`)
          .send(announcementData)
          .expect(201);

        expect(response.body).toMatchObject({
          title: announcementData.title,
          content: announcementData.content,
          priority: announcementData.priority,
          active: announcementData.active
        });
        
        testAnnouncement = response.body;
      });

      test('should read announcement successfully', async () => {
        const response = await request(app)
          .get(`/api/announcements/${testAnnouncement.id}`)
          .set('Authorization', `Bearer ${adminToken}`)
          .expect(200);

        expect(response.body.id).toBe(testAnnouncement.id);
        expect(response.body.title).toBe(testAnnouncement.title);
      });

      test('should update announcement successfully', async () => {
        const updateData = {
          title: 'Updated Test Announcement',
          content: 'Updated content'
        };

        const response = await request(app)
          .put(`/api/announcements/${testAnnouncement.id}`)
          .set('Authorization', `Bearer ${adminToken}`)
          .send(updateData)
          .expect(200);

        expect(response.body.title).toBe(updateData.title);
        expect(response.body.content).toBe(updateData.content);
      });

      test('should delete announcement successfully', async () => {
        await request(app)
          .delete(`/api/announcements/${testAnnouncement.id}`)
          .set('Authorization', `Bearer ${adminToken}`)
          .expect(204);

        // Verify deletion
        await request(app)
          .get(`/api/announcements/${testAnnouncement.id}`)
          .set('Authorization', `Bearer ${adminToken}`)
          .expect(404);
      });
    });

    // Error path tests
    describe('Error path scenarios', () => {
      test('should fail to create announcement with invalid data', async () => {
        const invalidData = {
          title: '', // Empty title should fail
          content: 'Content without title'
        };

        await request(app)
          .post('/api/announcements')
          .set('Authorization', `Bearer ${adminToken}`)
          .send(invalidData)
          .expect(400);
      });

      test('should fail to read non-existent announcement', async () => {
        await request(app)
          .get('/api/announcements/99999')
          .set('Authorization', `Bearer ${adminToken}`)
          .expect(404);
      });

      test('should fail to update non-existent announcement', async () => {
        const updateData = { title: 'Updated Title' };

        await request(app)
          .put('/api/announcements/99999')
          .set('Authorization', `Bearer ${adminToken}`)
          .send(updateData)
          .expect(404);
      });

      test('should fail to delete non-existent announcement', async () => {
        await request(app)
          .delete('/api/announcements/99999')
          .set('Authorization', `Bearer ${adminToken}`)
          .expect(404);
      });
    });
  });

  // TC-002: Authorization for announcement management
  describe('TC-002: Authorization for announcement management', () => {
    let testAnnouncementForAuth;

    beforeEach(async () => {
      // Create test announcement for authorization tests
      const announcementData = {
        title: 'Auth Test Announcement',
        content: 'Content for authorization testing',
        priority: 'medium',
        active: true
      };

      const response = await request(app)
        .post('/api/announcements')
        .set('Authorization', `Bearer ${adminToken}`)
        .send(announcementData);
      
      testAnnouncementForAuth = response.body;
    });

    afterEach(async () => {
      // Clean up test announcement
      if (testAnnouncementForAuth) {
        await request(app)
          .delete(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', `Bearer ${adminToken}`);
      }
    });

    // Happy path tests
    describe('Happy path scenarios', () => {
      test('admin should be able to create announcements', async () => {
        const announcementData = {
          title: 'Admin Created Announcement',
          content: 'This announcement was created by admin',
          priority: 'high'
        };

        const response = await request(app)
          .post('/api/announcements')
          .set('Authorization', `Bearer ${adminToken}`)
          .send(announcementData)
          .expect(201);

        expect(response.body.title).toBe(announcementData.title);
        
        // Cleanup
        await request(app)
          .delete(`/api/announcements/${response.body.id}`)
          .set('Authorization', `Bearer ${adminToken}`);
      });

      test('regular user should be able to read announcements', async () => {
        await request(app)
          .get(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', `Bearer ${userToken}`)
          .expect(200);
      });

      test('admin should be able to update announcements', async () => {
        const updateData = { title: 'Updated by Admin' };

        await request(app)
          .put(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', `Bearer ${adminToken}`)
          .send(updateData)
          .expect(200);
      });

      test('admin should be able to delete announcements', async () => {
        await request(app)
          .delete(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', `Bearer ${adminToken}`)
          .expect(204);
        
        testAnnouncementForAuth = null; // Prevent cleanup attempt
      });
    });

    // Error path tests
    describe('Error path scenarios', () => {
      test('unauthenticated user should not be able to create announcements', async () => {
        const announcementData = {
          title: 'Unauthorized Creation Attempt',
          content: 'This should fail'
        };

        await request(app)
          .post('/api/announcements')
          .send(announcementData)
          .expect(401);
      });

      test('regular user should not be able to create announcements', async () => {
        const announcementData = {
          title: 'User Creation Attempt',
          content: 'This should fail for regular user'
        };

        await request(app)
          .post('/api/announcements')
          .set('Authorization', `Bearer ${userToken}`)
          .send(announcementData)
          .expect(403);
      });

      test('regular user should not be able to update announcements', async () => {
        const updateData = { title: 'User Update Attempt' };

        await request(app)
          .put(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', `Bearer ${userToken}`)
          .send(updateData)
          .expect(403);
      });

      test('regular user should not be able to delete announcements', async () => {
        await request(app)
          .delete(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', `Bearer ${userToken}`)
          .expect(403);
      });

      test('unauthenticated user should not be able to access announcements', async () => {
        await request(app)
          .get(`/api/announcements/${testAnnouncementForAuth.id}`)
          .expect(401);
      });

      test('invalid token should be rejected', async () => {
        await request(app)
          .get(`/api/announcements/${testAnnouncementForAuth.id}`)
          .set('Authorization', 'Bearer invalid_token')
          .expect(401);
      });
    });
  });
});