      const result = await mockAuthService.authenticate({
        username: 'testuser',
        password: 'wrongpassword'
      });

      expect(result.success).toBe(false);
      expect(result.error).toBe('Account temporarily locked due to multiple failed login attempts');
      expect(result.code).toBe('AUTH_ACCOUNT_LOCKED');
      expect(result.lockoutTime).toBe('2023-12-01T10:30:00Z');
    });

    it('TC-004: should handle expired JWT token validation', async () => {
      mockAuthService.validateToken.mockResolvedValue({
        valid: false,
        error: 'Token has expired',
        code: 'TOKEN_EXPIRED',
        expiredAt: '2023-12-01T09:00:00Z'
      });

      const result = await mockAuthService.validateToken('expired-jwt-token');

      expect(result.valid).toBe(false);
      expect(result.error).toBe('Token has expired');
      expect(result.code).toBe('TOKEN_EXPIRED');
      expect(result.expiredAt).toBe('2023-12-01T09:00:00Z');
    });

    it('TC-004: should handle malformed JWT token', async () => {
      mockAuthService.validateToken.mockResolvedValue({
        valid: false,
        error: 'Invalid token format',
        code: 'TOKEN_MALFORMED'
      });

      const result = await mockAuthService.validateToken('invalid.token.format');

      expect(result.valid).toBe(false);
      expect(result.error).toBe('Invalid token format');
      expect(result.code).toBe('TOKEN_MALFORMED');
    });

    it('TC-004: should handle JWT token signature verification failure', async () => {
      mockAuthService.validateToken.mockResolvedValue({
        valid: false,
        error: 'Token signature verification failed',
        code: 'TOKEN_SIGNATURE_INVALID'
      });

      const result = await mockAuthService.validateToken('tampered.jwt.token');

      expect(result.valid).toBe(false);
      expect(result.error).toBe('Token signature verification failed');
      expect(result.code).toBe('TOKEN_SIGNATURE_INVALID');
    });

    it('TC-004: should handle unauthorized access attempt with insufficient permissions', async () => {
      mockAuthService.checkPermissions.mockResolvedValue({
        authorized: false,
        userRole: 'user',
        requiredPermission: 'delete_announcement'
      });

      mockApiService.deleteAnnouncement.mockResolvedValue({
        success: false,
        error: 'Insufficient permissions to delete announcement',
        code: 'FORBIDDEN',
        statusCode: 403
      });

      const authResult = await mockAuthService.checkPermissions('user-token', 'delete_announcement');
      expect(authResult.authorized).toBe(false);

      const result = await mockApiService.deleteAnnouncement(123, 'user-token');

      expect(result.success).toBe(false);
      expect(result.error).toBe('Insufficient permissions to delete announcement');
      expect(result.code).toBe('FORBIDDEN');
      expect(result.statusCode).toBe(403);
    });

    it('TC-004: should handle missing authentication token', async () => {
      mockApiService.getAnnouncements.mockResolvedValue({
        success: false,
        error: 'Authentication token is required',
        code: 'TOKEN_MISSING',
        statusCode: 401
      });

      const result = await mockApiService.getAnnouncements(null);

      expect(result.success).toBe(false);
      expect(result.error).toBe('Authentication token is required');
      expect(result.code).toBe('TOKEN_MISSING');
      expect(result.statusCode).toBe(401);
    });

    it('TC-004: should handle SQL injection attempt in authentication', async () => {
      mockAuthService.authenticate.mockResolvedValue({
        success: false,
        error: 'Invalid input detected',
        code: 'SECURITY_VIOLATION',
        blocked: true
      });

      const result = await mockAuthService.authenticate({
        username: "admin' OR '1'='1",
        password: "password"
      });

      expect(result.success).toBe(false);
      expect(result.error).toBe('Invalid input detected');
      expect(result.code).toBe('SECURITY_VIOLATION');
      expect(result.blocked).toBe(true);
    });

    it('TC-004: should handle XSS attempt in announcement content', async () => {
      mockApiService.createAnnouncement.mockResolvedValue({
        success: false,
        error: 'Content contains potentially harmful scripts',
        code: 'CONTENT_SECURITY_VIOLATION',
        statusCode: 400
      });

      const result = await mockApiService.createAnnouncement(
        {
          title: 'Test Announcement',
          content: '<script>alert("XSS")</script>This is malicious content'
        },
        'valid-admin-token'
      );

      expect(result.success).toBe(false);
      expect(result.error).toBe('Content contains potentially harmful scripts');
      expect(result.code).toBe('CONTENT_SECURITY_VIOLATION');
      expect(result.statusCode).toBe(400);
    });

    it('TC-004: should handle refresh token theft/reuse attempt', async () => {
      mockAuthService.refreshToken.mockResolvedValue({
        success: false,
        error: 'Refresh token has been compromised or already used',
        code: 'TOKEN_COMPROMISED',
        action: 'all_tokens_invalidated'
      });

      const result = await mockAuthService.refreshToken('compromised-refresh-token');

      expect(result.success).toBe(false);
      expect(result.error).toBe('Refresh token has been compromised or already used');
      expect(result.code).toBe('TOKEN_COMPROMISED');
      expect(result.action).toBe('all_tokens_invalidated');
    });

    it('TC-004: should handle rate limiting for authentication attempts', async () => {
      mockAuthService.authenticate.mockResolvedValue({
        success: false,
        error: 'Too many authentication attempts',
        code: 'RATE_LIMITED',
        statusCode: 429,
        retryAfter: 300,
        remainingAttempts: 0
      });

      const result = await mockAuthService.authenticate({
        username: 'testuser',
        password: 'password'
      });

      expect(result.success).toBe(false);
      expect(result.error).toBe('Too many authentication attempts');
      expect(result.code).toBe('RATE_LIMITED');
      expect(result.statusCode).toBe(429);
      expect(result.retryAfter).toBe(300);
    });

    it('TC-004: should handle session hijacking detection', async () => {
      mockAuthService.validateToken.mockResolvedValue({
        valid: false,
        error: 'Token used from suspicious location',
        code: 'SESSION_SECURITY_VIOLATION',
        ipMismatch: true,
        userAgentMismatch: false
      });

      const result = await mockAuthService.validateToken('potentially-hijacked-token');

      expect(result.valid).toBe(false);
      expect(result.error).toBe('Token used from suspicious location');
      expect(result.code).toBe('SESSION_SECURITY_VIOLATION');
      expect(result.ipMismatch).toBe(true);
    });
  });
});

describe('TC-005: Authentication and authorization', () => {
  const mockAuthService = {
    authenticate: vi.fn(),
    authorize: vi.fn(),
    validateCredentials: vi.fn(),
    checkRolePermissions: vi.fn(),
    enforceAccessControl: vi.fn(),
    validateSession: vi.fn(),
    logout: vi.fn()
  };

  const mockUserService = {
    getUserById: vi.fn(),
    getUserRoles: vi.fn(),
    updateUserPermissions: vi.fn()
  };

  beforeEach(() => {
    vi.clearAllMocks();
  });

  describe('Happy path - Authentication and authorization flows', () => {
    it('TC-005: should successfully authenticate user with valid credentials and assign proper roles', async () => {
      mockAuthService.authenticate.mockResolvedValue({
        success: true,
        user: {
          id: 1,
          username: 'admin_user',
          email: 'admin@example.com',
          roles: ['admin', 'moderator'],
          permissions: ['create', 'read', 'update', 'delete'],
          lastLogin: '2023-12-01T10:00:00Z'
        },
        session: {
          id: 'session-123',
          token: 'valid-auth-token',
          expiresAt: '2023-12-01T18:00:00Z'
        }
      });

      const result = await mockAuthService.authenticate({
        username: 'admin_user',
        password: 'SecurePassword123!'
      });

      expect(result.success).toBe(true);
      expect(result.user.roles).toContain('admin');
      expect(result.user.roles).toContain('moderator');
      expect(result.user.permissions).toContain('create');
      expect(result.user.permissions).toContain('delete');
      expect(result.session.token).toBe('valid-auth-token');
    });

    it('TC-005: should successfully authorize user with admin role for protected resource access', async () => {
      mockAuthService.authorize.mockResolvedValue({
        authorized: true,
        user: { id: 1, roles: ['admin'] },
        resource: 'user_management',
        action: 'delete_user',
        permissions: ['full_access'],
        timestamp: '2023-12-01T10:00:00Z'
      });

      const result = await mockAuthService.authorize({
        userId: 1,
        resource: 'user_management',
        action: 'delete_user'
      });

      expect(result.authorized).toBe(true);
      expect(result.user.roles).toContain('admin');
      expect(result.permissions).toContain('full_access');
      expect(result.resource).toBe('user_management');
      expect(result.action).toBe('delete_user');
