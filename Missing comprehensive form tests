// TC-003: Form validation and submission tests
describe('TC-003: Form validation and submission', () => {
  let form, contactForm;
  
  beforeEach(() => {
    // Set up DOM structure for testing
    document.body.innerHTML = `
      <form id="contact-form">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" required minlength="2" maxlength="50" pattern="[A-Za-z\\s]+">
        <div id="name-error" class="error-message" style="display: none;"></div>
        
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required>
        <div id="email-error" class="error-message" style="display: none;"></div>
        
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" pattern="[0-9\\-\\(\\)\\+\\s]+">
        <div id="phone-error" class="error-message" style="display: none;"></div>
        
        <label for="message">Message *</label>
        <textarea id="message" name="message" required minlength="10" maxlength="1000"></textarea>
        <div id="message-error" class="error-message" style="display: none;"></div>
        
        <label for="category">Category</label>
        <select id="category" name="category">
          <option value="general">General</option>
          <option value="support">Support</option>
          <option value="sales">Sales</option>
        </select>
        <div id="category-error" class="error-message" style="display: none;"></div>
        
        <label for="priority">Priority</label>
        <select id="priority" name="priority">
          <option value="low">Low</option>
          <option value="medium">Medium</option>
          <option value="high">High</option>
        </select>
        <div id="priority-error" class="error-message" style="display: none;"></div>
        
        <button type="submit" id="submit-btn">Submit</button>
        <button type="button" id="reset-btn">Reset</button>
      </form>
    `;
    
    form = document.getElementById('contact-form');
    contactForm = new ContactForm(form);
  });

  describe('Happy path - valid form submission', () => {
    test('should validate and submit form with all valid fields', async () => {
      // Arrange
      contactForm.fields.name.value = 'John Doe';
      contactForm.fields.email.value = 'john.doe@example.com';
      contactForm.fields.phone.value = '+1-555-123-4567';
      contactForm.fields.message.value = 'This is a valid test message with sufficient length';
      contactForm.fields.category.value = 'general';
      contactForm.fields.priority.value = 'medium';
      
      // Mock successful API response
      contactForm.submitFormData = jest.fn().mockResolvedValue({ success: true, id: 'test123' });
      
      // Act
      const isValid = contactForm.validateForm();
      await contactForm.handleSubmit(new Event('submit'));
      
      // Assert
      expect(isValid).toBe(true);
      expect(contactForm.submitFormData).toHaveBeenCalled();
      expect(document.querySelector('.success-message')).toBeTruthy();
    });

    test('should validate individual fields correctly when valid', () => {
      // Arrange & Act
      contactForm.fields.name.value = 'Jane Smith';
      contactForm.fields.email.value = 'jane@test.com';
      
      const nameValid = contactForm.validateField(contactForm.fields.name);
      const emailValid = contactForm.validateField(contactForm.fields.email);
      
      // Assert
      expect(nameValid).toBe(true);
      expect(emailValid).toBe(true);
      expect(contactForm.fields.name.getAttribute('aria-invalid')).toBe('false');
      expect(contactForm.fields.email.getAttribute('aria-invalid')).toBe('false');
    });
  });

  describe('Error path - validation failures', () => {
    test('should show error for required fields when empty', () => {
      // Arrange
      contactForm.fields.name.value = '';
      contactForm.fields.email.value = '';
      contactForm.fields.message.value = '';
      
      // Act
      const nameValid = contactForm.validateField(contactForm.fields.name);
      const emailValid = contactForm.validateField(contactForm.fields.email);
      const messageValid = contactForm.validateField(contactForm.fields.message);
      
      // Assert
      expect(nameValid).toBe(false);
      expect(emailValid).toBe(false);
      expect(messageValid).toBe(false);
      expect(document.getElementById('name-error').textContent).toContain('required');
      expect(document.getElementById('email-error').textContent).toContain('required');
      expect(document.getElementById('message-error').textContent).toContain('required');
    });

    test('should show error for invalid email format', () => {
      // Arrange
      contactForm.fields.email.value = 'invalid-email';
      
      // Act
      const isValid = contactForm.validateField(contactForm.fields.email);
      
      // Assert
      expect(isValid).toBe(false);
      expect(document.getElementById('email-error').textContent).toContain('valid email address');
      expect(contactForm.fields.email.getAttribute('aria-invalid')).toBe('true');
    });

    test('should show error for name with invalid characters', () => {
      // Arrange
      contactForm.fields.name.value = 'John123!';
      
      // Act
      const isValid = contactForm.validateField(contactForm.fields.name);
      
      // Assert
      expect(isValid).toBe(false);
      expect(document.getElementById('name-error').textContent).toContain('letters and spaces');
    });

    test('should show error for message too short', () => {
      // Arrange
      contactForm.fields.message.value = 'Short';
      
      // Act
      const isValid = contactForm.validateField(contactForm.fields.message);
      
      // Assert
      expect(isValid).toBe(false);
      expect(document.getElementById('message-error').textContent).toContain('at least');
    });

    test('should disable submit button when form is invalid', () => {
      // Arrange
      contactForm.fields.name.value = '';
      contactForm.fields.email.value = 'invalid';
      
      // Act
      contactForm.validateForm();
      
      // Assert
      expect(contactForm.submitButton.disabled).toBe(true);
    });

    test('should handle submission error gracefully', async () => {
      // Arrange
      contactForm.fields.name.value = 'John Doe';
      contactForm.fields.email.value = 'john@test.com';
      contactForm.fields.message.value = 'Valid message content here';
      
      // Mock API error
      contactForm.submitFormData = jest.fn().mockRejectedValue(new Error('Network error'));
      
      // Act
      await contactForm.handleSubmit(new Event('submit'));
      
      // Assert
      expect(document.querySelector('.form-error-message')).toBeTruthy();
      expect(document.querySelector('.form-error-message').textContent).toContain('Network error');
    });

    test('should validate enum fields with invalid values', () => {
      // Arrange
      contactForm.fields.category.value = 'invalid-category';
      contactForm.fields.priority.value = 'invalid-priority';
      
      // Act
      const categoryValid = contactForm.validateField(contactForm.fields.category);
      const priorityValid = contactForm.validateField(contactForm.fields.priority);
      
      // Assert
      expect(categoryValid).toBe(false);
      expect(priorityValid).toBe(false);
      expect(document.getElementById('category-error').textContent).toContain('valid category');
      expect(document.getElementById('priority-error').textContent).toContain('valid priority');
    });
  });

  describe('Form reset functionality', () => {
    test('should reset form and clear all errors', () => {
      // Arrange
      contactForm.fields.name.value = 'Test';
      contactForm.showFieldError(contactForm.fields.name, 'Test error');
      
      // Act
      contactForm.handleReset();
      
      // Assert
      expect(contactForm.fields.name.value).toBe('');
      expect(document.getElementById('name-error').style.display).toBe('none');
      expect(contactForm.fields.name.getAttribute('aria-invalid')).toBe('false');
    });
  });

  afterEach(() => {
    document.body.innerHTML = '';
    jest.clearAllMocks();
  });
});