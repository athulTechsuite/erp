          expect.objectContaining({
            title: 'CSRF Protected Announcement',
            content: 'This form includes CSRF protection'
          })
        );
      });
    });
  });

  describe('TC-004 Error Path - XSS and injection attack prevention', () => {
    it('should prevent XSS attacks via script tag injection in title', async () => {
      const user = userEvent.setup();
      const mockSubmitXSSPrevention = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitXSSPrevention} />
        </TestWrapper>
      );

      // Attempt XSS injection in title
      const maliciousTitle = '<script>alert("XSS attack in title")</script>Malicious Title';
      await user.type(screen.getByLabelText(/title/i), maliciousTitle);
      await user.type(screen.getByLabelText(/content/i), 'Normal content');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        const callArgs = mockSubmitXSSPrevention.mock.calls[0]?.[0];
        // Verify script tags are stripped or escaped
        expect(callArgs?.title).not.toContain('<script>');
        expect(callArgs?.title).not.toContain('alert(');
        // Should contain sanitized version
        expect(callArgs?.title).toContain('Malicious Title');
      });
    });

    it('should prevent XSS attacks via image onerror injection in content', async () => {
      const user = userEvent.setup();
      const mockSubmitImageXSSPrevention = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitImageXSSPrevention} />
        </TestWrapper>
      );

      // Attempt image-based XSS injection
      const maliciousContent = '<img src="invalid.jpg" onerror="alert(\'XSS via image\')" />Normal content';
      await user.type(screen.getByLabelText(/title/i), 'Image XSS Test');
      await user.type(screen.getByLabelText(/content/i), maliciousContent);
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        const callArgs = mockSubmitImageXSSPrevention.mock.calls[0]?.[0];
        // Verify onerror attribute is removed
        expect(callArgs?.content).not.toContain('onerror');
        expect(callArgs?.content).not.toContain('alert(');
        // Should still contain safe content
        expect(callArgs?.content).toContain('Normal content');
      });
    });

    it('should prevent SQL injection attempts in form data', async () => {
      const user = userEvent.setup();
      const mockSubmitSQLInjectionPrevention = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitSQLInjectionPrevention} />
        </TestWrapper>
      );

      // Attempt SQL injection patterns
      const sqlInjectionTitle = "'; DROP TABLE announcements; --";
      const sqlInjectionContent = "' UNION SELECT * FROM users WHERE '1'='1";

      await user.type(screen.getByLabelText(/title/i), sqlInjectionTitle);
      await user.type(screen.getByLabelText(/content/i), sqlInjectionContent);
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        const callArgs = mockSubmitSQLInjectionPrevention.mock.calls[0]?.[0];
        // Data should be escaped or rejected
        expect(callArgs?.title).toBeDefined();
        expect(callArgs?.content).toBeDefined();
        // SQL keywords should be escaped or sanitized
        expect(callArgs?.title).not.toMatch(/DROP\s+TABLE/i);
        expect(callArgs?.content).not.toMatch(/UNION\s+SELECT/i);
      });
    });

    it('should reject dangerous HTML attributes and event handlers', async () => {
      const user = userEvent.setup();
      const mockSubmitDangerousHTML = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitDangerousHTML} />
        </TestWrapper>
      );

      // Attempt various dangerous HTML attributes
      const dangerousContent = `
        <div onclick="alert('XSS')" onmouseover="steal_data()">
          <a href="javascript:alert('XSS')">Click me</a>
          <input type="text" onfocus="malicious_code()" />
          <iframe src="javascript:alert('XSS')"></iframe>
        </div>
      `;

      await user.type(screen.getByLabelText(/title/i), 'Dangerous HTML Test');
      await user.type(screen.getByLabelText(/content/i), dangerousContent);
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        const callArgs = mockSubmitDangerousHTML.mock.calls[0]?.[0];
        // Verify dangerous attributes are removed
        expect(callArgs?.content).not.toContain('onclick');
        expect(callArgs?.content).not.toContain('onmouseover');
        expect(callArgs?.content).not.toContain('onfocus');
        expect(callArgs?.content).not.toContain('javascript:');
        expect(callArgs?.content).not.toContain('<iframe');
      });
    });

    it('should handle DOM-based XSS prevention in displayed content', () => {
      const maliciousAnnouncement = {
        id: '1',
        title: '<script>document.write("XSS")</script>Malicious',
        content: '<img src=x onerror=alert("DOM XSS")>Content',
        category: 'general',
        createdAt: '2024-01-01T00:00:00Z',
        author: { id: 'admin1', name: 'Admin User' }
      };

      render(
        <TestWrapper>
          <AnnouncementDetail announcement={maliciousAnnouncement} />
        </TestWrapper>
      );

