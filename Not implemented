      expect(screen.getByText(/insufficient privileges/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });
  });
});

describe('TC-004: Security tests for XSS and injection', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('TC-004 Happy Path - Secure input handling and validation', () => {
    it('should sanitize and accept safe HTML content in announcements', async () => {
      const user = userEvent.setup();
      const mockSubmitSanitized = jest.fn().mockResolvedValue({
