      mockAuthService.validateCredentials.mockResolvedValue({
        valid: true,
        user: { id: 2, username: 'secure_user' },
        passwordStrength: 'strong',
        lastPasswordChange: '2023-11-01T10:00:00Z',
        requiresPasswordChange: false,
        accountLocked: false
      });

      const result = await mockAuthService.validateCredentials({
        username: 'secure_user',
        password: 'VerySecureP@ssw0rd123!'
      });

      expect(result.valid).toBe(true);
      expect(result.passwordStrength).toBe('strong');
      expect(result.requiresPasswordChange).toBe(false);
      expect(result.accountLocked).toBe(false);
    });

    it('TC-005: should successfully check role-based permissions for resource access', async () => {
      mockAuthService.checkRolePermissions.mockResolvedValue({
        hasPermission: true,
        userRoles: ['moderator', 'content_manager'],
        requiredRoles: ['moderator'],
        resourcePermissions: ['read_announcements', 'create_announcements', 'moderate_content'],
        inheritedPermissions: ['read_announcements']
      });

      const result = await mockAuthService.checkRolePermissions({
        userId: 3,
        resource: 'announcements',
        requiredRoles: ['moderator']
      });

      expect(result.hasPermission).toBe(true);
      expect(result.userRoles).toContain('moderator');
      expect(result.userRoles).toContain('content_manager');
      expect(result.resourcePermissions).toContain('create_announcements');
      expect(result.inheritedPermissions).toContain('read_announcements');
