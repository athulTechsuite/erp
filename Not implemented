    it('should handle CSV injection prevention for data export functionality', async () => {
      const user = userEvent.setup();
      const mockSubmitCSVInjection = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitCSVInjection} />
        </TestWrapper>
