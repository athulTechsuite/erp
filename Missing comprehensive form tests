        mockAPI.submit.mockRejectedValue(error);
      },
      
      simulateAuthenticationError: () => {
        const error = new Error('Authentication required');
        error.status = 401;
        error.response = {
          data: { message: 'Invalid or expired token' },
          status: 401
        };
        mockAPI.submit.mockRejectedValue(error);
      },
      
      simulateTimeoutError: () => {
