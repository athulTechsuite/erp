      const authResult = await mockAuthService.checkPermissions('valid-admin-token', 'create_announcement');
      expect(authResult.authorized).toBe(true);

      const result = await mockApiService.createAnnouncement(
        {
          title: 'New Announcement',
          content: 'This is a secure announcement'
        },
