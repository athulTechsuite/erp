      submit: jest.fn(),
      
      // Simulate various API error scenarios
      simulateNetworkError: () => {
        mockAPI.submit.mockRejectedValue(new Error('Network request failed'));
      },
      
      simulateServerError: (statusCode = 500) => {
        const error = new Error('Server error');
        error.status = statusCode;
        error.response = { 
          data: { message: 'Internal server error' },
          status: statusCode
        };
        mockAPI.submit.mockRejectedValue(error);
      },
      
      simulateValidationError: () => {
        const error = new Error('Validation failed');
        error.status = 422;
        error.response = {
          data: { 
            message: 'Validation failed',
            errors: {
              email: ['Invalid email format'],
              name: ['Name contains invalid characters']
            }
          },
          status: 422
        };
        mockAPI.submit.mockRejectedValue(error);
      },
      
      simulateRateLimitError: () => {
        const error = new Error('Too many requests');
        error.status = 429;
        error.response = {
          data: { message: 'Rate limit exceeded. Try again later.' },
          status: 429,
          headers: { 'retry-after': '60' }
