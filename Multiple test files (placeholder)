// TC-004: Input validation and error handling test suite
// This file provides comprehensive test coverage for input validation scenarios

describe('TC-004: Input validation and error handling', () => {
  
  describe('Happy path scenarios', () => {
    
    test('TC-004-HP-001: Valid input should be accepted and processed correctly', () => {
      const validInput = {
        name: 'John Doe',
        email: 'john.doe@example.com',
        age: 25
      };
      
      const result = validateInput(validInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
      expect(result.data).toEqual(validInput);
    });
    
    test('TC-004-HP-002: Edge case valid inputs should be handled properly', () => {
      const edgeCaseInput = {
        name: 'A',
        email: 'a@b.co',
        age: 18
      };
      
      const result = validateInput(edgeCaseInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
    });

    test('TC-004-HP-003: Maximum valid age should be accepted', () => {
      const maxAgeInput = {
        name: 'Senior User',
        email: 'senior@example.com',
        age: 120
      };
      
      const result = validateInput(maxAgeInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
    });

    test('TC-004-HP-004: Long valid name should be accepted', () => {
      const longNameInput = {
        name: 'John Michael Christopher Alexander Smith-Johnson',
        email: 'long.name@example.com',
        age: 30
      };
      
      const result = validateInput(longNameInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
    });
    
  });
  
  describe('Error path scenarios', () => {
    
    test('TC-004-EP-001: Missing required fields should return validation errors', () => {
      const invalidInput = {
        name: '',
        email: 'john.doe@example.com'
        // age is missing
      };
      
      const result = validateInput(invalidInput);
      
      expect(result.isValid).toBe(false);
      expect(result.errors).toContain('Name is required');
      expect(result.errors).toContain('Age is required');
    });
    
    test('TC-004-EP-002: Invalid email format should be rejected', () => {
      const invalidInput = {
        name: 'John Doe',
        email: 'invalid-email',
        age: 25
      };
      
      const result = validateInput(invalidInput);
      
      expect(result.isValid).toBe(false);
      expect(result.errors).toContain('Invalid email format');
    });
    
    test('TC-004-EP-003: Out of range values should be rejected', () => {
      const invalidInput = {
        name: 'John Doe',
        email: 'john.doe@example.com',
        age: -5
      };
      
      const result = validateInput(invalidInput);
      
      expect(result.isValid).toBe(false);
      expect(result.errors).toContain('Age must be a positive number');
    });
    
    test('TC-004-EP-004: Null or undefined input should be handled gracefully', () => {
      expect(() => validateInput(null)).not.toThrow();
      expect(() => validateInput(undefined)).not.toThrow();
      
      const nullResult = validateInput(null);
      const undefinedResult = validateInput(undefined);
      
      expect(nullResult.isValid).toBe(false);
      expect(undefinedResult.isValid).toBe(false);
      expect(nullResult.errors).toContain('Input cannot be null or undefined');
      expect(undefinedResult.errors).toContain('Input cannot be null or undefined');
    });

    test('TC-004-EP-005: Empty object should be rejected', () => {
      const emptyInput = {};
      
      const result = validateInput(emptyInput);
      
      expect(result.isValid).toBe(false);
      expect(result.errors).toContain('Name is required');
      expect(result.errors).toContain('Email is required');
      expect(result.errors).toContain('Age is required');
    });

    test('TC-004-EP-006: Multiple invalid email formats should be rejected', () => {
      const testCases = [
        'plaintext',
        '@example.com',
        'test@',
        'test..test@example.com',
        'test@example',
        'test@.com'
      ];

      testCases.forEach(email => {
        const invalidInput = {
          name: 'Test User',
          email: email,
          age: 25
        };
        
        const result = validateInput(invalidInput);
        
        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Invalid email format');
      });
    });

    test('TC-004-EP-007: Various invalid age values should be rejected', () => {
      const invalidAges = [-1, -100, 'not a number', NaN, Infinity, -Infinity];

      invalidAges.forEach(age => {
        const invalidInput = {
          name: 'Test User',
          email: 'test@example.com',
          age: age
        };
        
        const result = validateInput(invalidInput);
        
        expect(result.isValid).toBe(false);
        expect(result.errors.length).toBeGreaterThan(0);
      });
    });

    test('TC-004-EP-008: Whitespace-only name should be rejected', () => {
      const invalidInput = {
        name: '   ',
        email: 'test@example.com',
        age: 25
      };
      
      const result = validateInput(invalidInput);
      
      expect(result.isValid).toBe(false);
      expect(result.errors).toContain('Name is required');
    });
    
  });

  describe('Boundary testing', () => {
    
    test('TC-004-BT-001: Zero age should be handled correctly', () => {
      const zeroAgeInput = {
        name: 'Newborn',
        email: 'parent@example.com',
        age: 0
      };
      
      const result = validateInput(zeroAgeInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
    });

    test('TC-004-BT-002: Single character name should be valid', () => {
      const singleCharInput = {
        name: 'X',
        email: 'x@example.com',
        age: 25
      };
      
      const result = validateInput(singleCharInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
    });

    test('TC-004-BT-003: Minimum valid email should work', () => {
      const minEmailInput = {
        name: 'Test',
        email: 'a@b.c',
        age: 25
      };
      
      const result = validateInput(minEmailInput);
      
      expect(result.isValid).toBe(true);
      expect(result.errors).toHaveLength(0);
    });
    
  });
  
});

// Mock function for testing purposes
function validateInput(input) {
  if (input === null || input === undefined) {
    return {
      isValid: false,
      errors: ['Input cannot be null or undefined'],
      data: null
    };
  }
  
  const errors = [];
  
  if (!input.name || input.name.trim() === '') {
    errors.push('Name is required');
  }
  
  if (!input.email) {
    errors.push('Email is required');
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.email)) {
    errors.push('Invalid email format');
  }
  
  if (input.age === undefined || input.age === null) {
    errors.push('Age is required');
  } else if (typeof input.age === 'string' || isNaN(input.age) || !isFinite(input.age) || input.age < 0) {
    errors.push('Age must be a positive number');
  }
  
  return {
    isValid: errors.length === 0,
    errors: errors,
    data: errors.length === 0 ? input : null
  };
}