    test('should reject XSS attempts in name field', () => {
      const xssPayloads = [
        '<script>alert("xss")</script>',
        'javascript:alert("xss")',
        '<img src=x onerror=alert("xss")>',
        '<iframe src="javascript:alert(\'xss\')"></iframe>',
        'John<script>alert("xss")</script>Doe',
        'eval("alert(\'xss\')")'
      ];

      xssPayloads.forEach(payload => {
        nameInput.value = payload;
        
        // Validate using security validator
        expect(SecurityValidator.validateAgainstXSS(payload)).toBe(false);
        
        // Should also fail pattern validation
        expect(nameInput.validity.patternMismatch).toBe(true);
        expect(nameInput.validity.valid).toBe(false);
      });
    });

    test('should reject SQL injection attempts in all text fields', () => {
      const sqlPayloads = [
        "'; DROP TABLE users; --",
        "1' OR '1'='1",
        "admin'--",
        "'; SELECT * FROM users WHERE 't'='t",
        "1' UNION SELECT null, username, password FROM users--",
        "test@example.com'; DELETE FROM contacts; --"
      ];

      const textFields = [nameInput, emailInput, messageInput];
      
      sqlPayloads.forEach(payload => {
        textFields.forEach(field => {
          field.value = payload;
          
          // Validate using security validator
          expect(SecurityValidator.validateAgainstSQLInjection(payload)).toBe(false);
          expect(field.validity.valid).toBe(false);
        });
      });
    });

    test('should sanitize input while preserving valid content', () => {
      const testCases = [
        {
