import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import '@testing-library/jest-dom';
import { AnnouncementForm } from '../components/AnnouncementForm';
import { formValidator } from '../utils/formValidator';
import { announcementService } from '../services/announcementService';

// Mock the announcement service
jest.mock('../services/announcementService', () => ({
  announcementService: {
    submitAnnouncement: jest.fn(),
  }
}));

// Mock form validator utility
jest.mock('../utils/formValidator', () => ({
  formValidator: {
    validateField: jest.fn(),
    validateForm: jest.fn(),
    showFieldError: jest.fn(),
    clearFieldError: jest.fn(),
  }
}));

/**
 * TC-003: Company Announcement Form validation and submission tests
 * Comprehensive test coverage for form validation, submission, and error handling
 */
describe('TC-003: Company Announcement Form validation and submission', () => {
  const mockFormData = {
    title: 'Important Company Update',
    content: 'This is an important announcement about company policies and procedures that all employees should be aware of.',
    author: 'John Doe',
    email: 'john@company.com',
    department: 'Human Resources',
    priority: 'medium'
  };

  let user;

  beforeEach(() => {
    user = userEvent.setup();
    jest.clearAllMocks();
  });

  /**
   * Render AnnouncementForm component with default props
   */
  const renderAnnouncementForm = (props = {}) => {
    const defaultProps = {
      onSubmit: jest.fn(),
      onReset: jest.fn(),
      ...props
    };
    return render(<AnnouncementForm {...defaultProps} />);
  };

  // Happy path tests - TC-003 validation scenarios
  describe('TC-003 Happy path - valid form submission', () => {
    test('should successfully submit announcement form with valid data', async () => {
      // Arrange
      announcementService.submitAnnouncement.mockResolvedValue({
        success: true,
        id: 'ann_12345',
        publishedAt: new Date().toISOString()
      });
      formValidator.validateForm.mockReturnValue(true);

      const mockOnSubmit = jest.fn();
      renderAnnouncementForm({ onSubmit: mockOnSubmit });

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.selectOptions(screen.getByLabelText(/department/i), mockFormData.department);
      await user.selectOptions(screen.getByLabelText(/priority/i), mockFormData.priority);
      await user.click(screen.getByRole('button', { name: /publish announcement/i }));

      // Assert
      await waitFor(() => {
        expect(announcementService.submitAnnouncement).toHaveBeenCalledWith(
          expect.objectContaining({
            title: mockFormData.title,
            content: mockFormData.content,
            author: mockFormData.author,
            email: mockFormData.email,
            department: mockFormData.department,
            priority: mockFormData.priority
          })
        );
      });
      expect(mockOnSubmit).toHaveBeenCalled();
    });

    test('should validate email format correctly with various valid formats', async () => {
      // Arrange
      const validEmails = [
        'user@company.com',
        'test.email@corporate.org',
        'user+tag@domain.co.uk',
        'firstname.lastname@company.com'
      ];

      formValidator.validateField.mockReturnValue(true);
      renderAnnouncementForm();

      const emailInput = screen.getByLabelText(/email address/i);

      for (const email of validEmails) {
        // Act
        await user.clear(emailInput);
        await user.type(emailInput, email);
        fireEvent.blur(emailInput);

        // Assert
        expect(formValidator.validateField).toHaveBeenCalledWith(
          emailInput,
          expect.objectContaining({ type: 'email' })
        );
      }
    });

    test('should accept all required announcement fields when properly filled', async () => {
      // Arrange
      formValidator.validateForm.mockReturnValue(true);
      renderAnnouncementForm();

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), 'New Company Policy');
      await user.type(screen.getByLabelText(/announcement content/i), 'This announcement details the new company policy regarding remote work procedures.');
      await user.type(screen.getByLabelText(/author name/i), 'Jane Smith');
      await user.type(screen.getByLabelText(/email address/i), 'jane@company.com');
      await user.selectOptions(screen.getByLabelText(/department/i), 'Management');

      // Assert
      expect(formValidator.validateForm).toHaveBeenCalled();
      expect(screen.getByRole('button', { name: /publish announcement/i })).not.toBeDisabled();
    });

    test('should validate priority levels are properly selected', async () => {
      // Arrange
      const validPriorities = ['low', 'medium', 'high', 'urgent'];
      formValidator.validateField.mockReturnValue(true);
      renderAnnouncementForm();

      const prioritySelect = screen.getByLabelText(/priority/i);

      for (const priority of validPriorities) {
        // Act
        await user.selectOptions(prioritySelect, priority);
        fireEvent.blur(prioritySelect);

        // Assert
        expect(formValidator.validateField).toHaveBeenCalledWith(
          prioritySelect,
          expect.objectContaining({ required: true })
        );
      }
    });

    test('should enable submit button when announcement form is valid', async () => {
      // Arrange
      formValidator.validateForm.mockReturnValue(true);
      renderAnnouncementForm();

      const submitButton = screen.getByRole('button', { name: /publish announcement/i });

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);

      // Assert
      await waitFor(() => {
        expect(submitButton).not.toBeDisabled();
      });
    });
  });

  // Error path tests - TC-003 error scenarios
  describe('TC-003 Error path - invalid form submission', () => {
    test('should prevent submission when announcement title is empty', async () => {
      // Arrange
      formValidator.validateForm.mockReturnValue(false);
      formValidator.validateField.mockReturnValue(false);
      
      renderAnnouncementForm();

      // Act
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.click(screen.getByRole('button', { name: /publish announcement/i }));

      // Assert
      expect(formValidator.validateField).toHaveBeenCalledWith(
        screen.getByLabelText(/announcement title/i),
        expect.objectContaining({ required: true })
      );
      expect(announcementService.submitAnnouncement).not.toHaveBeenCalled();
    });

    test('should prevent submission when announcement content is empty', async () => {
      // Arrange
      formValidator.validateForm.mockReturnValue(false);
      formValidator.validateField.mockReturnValue(false);
      
      renderAnnouncementForm();

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.click(screen.getByRole('button', { name: /publish announcement/i }));

      // Assert
      expect(formValidator.validateField).toHaveBeenCalledWith(
        screen.getByLabelText(/announcement content/i),
        expect.objectContaining({ required: true })
      );
      expect(announcementService.submitAnnouncement).not.toHaveBeenCalled();
    });

    test('should prevent submission when author name is empty', async () => {
      // Arrange
      formValidator.validateForm.mockReturnValue(false);
      formValidator.validateField.mockReturnValue(false);
      
      renderAnnouncementForm();

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.click(screen.getByRole('button', { name: /publish announcement/i }));

      // Assert
      expect(formValidator.validateField).toHaveBeenCalledWith(
        screen.getByLabelText(/author name/i),
        expect.objectContaining({ required: true })
      );
      expect(announcementService.submitAnnouncement).not.toHaveBeenCalled();
    });

    test('should reject invalid email formats', async () => {
      // Arrange
      const invalidEmails = [
        'invalid-email',
        '@company.com',
        'test@',
        'test.com',
        'user@',
        '@domain.com',
        'user..double.dot@domain.com',
        'user@domain',
      ];

      formValidator.validateField.mockReturnValue(false);
      renderAnnouncementForm();

      const emailInput = screen.getByLabelText(/email address/i);

      for (const invalidEmail of invalidEmails) {
        // Act
        await user.clear(emailInput);
        await user.type(emailInput, invalidEmail);
        fireEvent.blur(emailInput);

        // Assert
        expect(formValidator.validateField).toHaveBeenCalledWith(
          emailInput,
          expect.objectContaining({ type: 'email' })
        );
      }
    });

    test('should validate announcement title length constraints', async () => {
      // Arrange
      formValidator.validateField.mockReturnValue(false);
      renderAnnouncementForm();

      const titleInput = screen.getByLabelText(/announcement title/i);

      const testCases = [
        { value: 'A', constraint: 'tooShort' },
        { value: 'A'.repeat(201), constraint: 'tooLong' }
      ];

      for (const testCase of testCases) {
        // Act
        await user.clear(titleInput);
        await user.type(titleInput, testCase.value);
        fireEvent.blur(titleInput);

        // Assert
        expect(formValidator.validateField).toHaveBeenCalledWith(
          titleInput,
          expect.objectContaining({
            minlength: 5,
            maxlength: 200
          })
        );
      }
    });

    test('should validate announcement content length constraints', async () => {
      // Arrange
      formValidator.validateField.mockReturnValue(false);
      renderAnnouncementForm();

      const contentInput = screen.getByLabelText(/announcement content/i);

      const testCases = [
        { value: 'Short', constraint: 'tooShort' },
        { value: 'A'.repeat(5001), constraint: 'tooLong' }
      ];

      for (const testCase of testCases) {
        // Act
        await user.clear(contentInput);
        await user.type(contentInput, testCase.value);
        fireEvent.blur(contentInput);

        // Assert
        expect(formValidator.validateField).toHaveBeenCalledWith(
          contentInput,
          expect.objectContaining({
            minlength: 20,
            maxlength: 5000
          })
        );
      }
    });

    test('should handle announcement submission API errors gracefully', async () => {
      // Arrange
      const apiErrors = [
        { status: 400, message: 'Bad Request: Invalid announcement data' },
        { status: 401, message: 'Unauthorized: Authentication required' },
        { status: 403, message: 'Forbidden: Insufficient permissions' },
        { status: 500, message: 'Internal Server Error: Service temporarily unavailable' },
        { status: 503, message: 'Service Unavailable: Maintenance in progress' }
      ];

      formValidator.validateForm.mockReturnValue(true);
      renderAnnouncementForm();

      for (const error of apiErrors) {
        // Arrange specific error
        const apiError = new Error(error.message);
        apiError.status = error.status;
        apiError.response = { status: error.status, data: { message: error.message } };
        announcementService.submitAnnouncement.mockRejectedValueOnce(apiError);

        // Act
        await user.clear(screen.getByLabelText(/announcement title/i));
        await user.type(screen.getByLabelText(/announcement title/i), `Test Title ${error.status}`);
        await user.clear(screen.getByLabelText(/announcement content/i));
        await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
        await user.clear(screen.getByLabelText(/author name/i));
        await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
        await user.clear(screen.getByLabelText(/email address/i));
        await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
        await user.click(screen.getByRole('button', { name: /publish announcement/i }));

        // Assert
        await waitFor(() => {
          expect(screen.getByRole('alert')).toBeInTheDocument();
          expect(screen.getByText(new RegExp(error.message, 'i'))).toBeInTheDocument();
        });

        // Clear error for next iteration
        jest.clearAllMocks();
      }
    });

    test('should handle network connectivity errors', async () => {
      // Arrange
      const networkError = new Error('Network Error');
      networkError.code = 'NETWORK_ERROR';
      announcementService.submitAnnouncement.mockRejectedValue(networkError);
      formValidator.validateForm.mockReturnValue(true);

      renderAnnouncementForm();

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.click(screen.getByRole('button', { name: /publish announcement/i }));

      // Assert
      await waitFor(() => {
        expect(screen.getByRole('alert')).toBeInTheDocument();
        expect(screen.getByText(/network error|connection failed/i)).toBeInTheDocument();
      });
    });
  });

  // Edge cases and accessibility tests - TC-003 comprehensive coverage
  describe('TC-003 Edge cases and accessibility', () => {
    test('should maintain focus on invalid field after submission attempt', async () => {
      // Arrange
      formValidator.validateForm.mockReturnValue(false);
      renderAnnouncementForm();

      const titleInput = screen.getByLabelText(/announcement title/i);

      // Act
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.click(screen.getByRole('button', { name: /publish announcement/i }));

      // Assert
      await waitFor(() => {
        expect(titleInput).toHaveFocus();
      });
    });

    test('should display appropriate error messages for invalid announcement fields', async () => {
      // Arrange
      const errorMessage = 'Announcement title is required.';
      formValidator.validateField.mockReturnValue(false);
      formValidator.showFieldError.mockImplementation(() => {
        // Simulate error message display
      });

      renderAnnouncementForm();

      // Act
      const titleInput = screen.getByLabelText(/announcement title/i);
      fireEvent.blur(titleInput);

      // Assert
      expect(formValidator.showFieldError).toHaveBeenCalledWith(
        titleInput,
        expect.any(String)
      );
    });

    test('should reset announcement form fields when reset button is clicked', async () => {
      // Arrange
      const mockOnReset = jest.fn();
      renderAnnouncementForm({ onReset: mockOnReset });

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await user.click(screen.getByRole('button', { name: /reset/i }));

      // Assert
      expect(mockOnReset).toHaveBeenCalled();
      expect(screen.getByLabelText(/announcement title/i)).toHaveValue('');
      expect(screen.getByLabelText(/announcement content/i)).toHaveValue('');
      expect(screen.getByLabelText(/author name/i)).toHaveValue('');
      expect(screen.getByLabelText(/email address/i)).toHaveValue('');
    });

    test('should handle special characters in announcement text inputs', async () => {
      // Arrange
      const specialCharTitles = [
        'Política de Empresa Actualizada',
        'Nouveau Règlement Français',
        'Richtlinie für Müller AG',
        'Company Policy: Q&A Session',
        'Annual Review - 2023/2024'
      ];

      formValidator.validateField.mockReturnValue(true);
      renderAnnouncementForm();

      const titleInput = screen.getByLabelText(/announcement title/i);

      for (const title of specialCharTitles) {
        // Act
        await user.clear(titleInput);
        await user.type(titleInput, title);
        fireEvent.blur(titleInput);

        // Assert
        expect(formValidator.validateField).toHaveBeenCalledWith(
          titleInput,
          expect.any(Object)
        );
      }
    });

    test('should validate department selection options', async () => {
      // Arrange
      const departments = ['Human Resources', 'IT', 'Finance', 'Marketing', 'Operations', 'Management'];
      formValidator.validateField.mockReturnValue(true);
      renderAnnouncementForm();

      const departmentSelect = screen.getByLabelText(/department/i);

      for (const dept of departments) {
        // Act
        await user.selectOptions(departmentSelect, dept);
        fireEvent.blur(departmentSelect);

        // Assert
        expect(departmentSelect).toHaveValue(dept);
      }
    });

    test('should handle announcement form submission with loading state', async () => {
      // Arrange
      let resolveSubmission;
      const submissionPromise = new Promise(resolve => {
        resolveSubmission = resolve;
      });
      
      announcementService.submitAnnouncement.mockReturnValue(submissionPromise);
      formValidator.validateForm.mockReturnValue(true);

      renderAnnouncementForm();

      // Act
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      
      const submitButton = screen.getByRole('button', { name: /publish announcement/i });
      await user.click(submitButton);

      // Assert loading state
      expect(screen.getByText(/publishing announcement/i)).toBeInTheDocument();
      expect(submitButton).toBeDisabled();

      // Resolve submission
      resolveSubmission({ success: true, id: 'ann_12345', publishedAt: new Date().toISOString() });

      await waitFor(() => {
        expect(screen.queryByText(/publishing announcement/i)).not.toBeInTheDocument();
        expect(submitButton).not.toBeDisabled();
      });
    });

    test('should validate announcement form state changes during user interaction', async () => {
      // Arrange
      formValidator.validateForm
        .mockReturnValueOnce(false) // After title input
        .mockReturnValueOnce(false) // After content input
        .mockReturnValueOnce(false) // After author input
        .mockReturnValueOnce(true); // After email input

      renderAnnouncementForm();

      // Act & Assert
      await user.type(screen.getByLabelText(/announcement title/i), mockFormData.title);
      expect(formValidator.validateForm).toHaveBeenCalled();

      await user.type(screen.getByLabelText(/announcement content/i), mockFormData.content);
      expect(formValidator.validateForm).toHaveBeenCalledTimes(2);

      await user.type(screen.getByLabelText(/author name/i), mockFormData.author);
      expect(formValidator.validateForm).toHaveBeenCalledTimes(3);

      await user.type(screen.getByLabelText(/email address/i), mockFormData.email);
      await waitFor(() => {
        expect(formValidator.validateForm).toHaveBeenCalledTimes(4);
        expect(screen.getByRole('button', { name: /publish announcement/i })).not.toBeDisabled();
      });
    });
  });
});