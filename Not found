      );

      expect(result.success).toBe(true);
      expect(result.id).toBe(123);
      expect(result.createdBy).toBe(1);
    });

    it('TC-004: should successfully fetch announcements with proper authentication', async () => {
      mockApiService.getAnnouncements.mockResolvedValue({
        success: true,
        data: [
          { 
            id: 1, 
            title: 'Public Announcement', 
            content: 'Content 1',
            isPublic: true,
            createdBy: 1
