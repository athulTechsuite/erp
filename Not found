  describe('Happy path - Authentication and authorization', () => {
    it('TC-004: should successfully authenticate user with valid credentials', async () => {
      mockAuthService.authenticate.mockResolvedValue({
        success: true,
        token: 'valid-jwt-token',
        refreshToken: 'valid-refresh-token',
        user: { 
          id: 1, 
          username: 'testuser', 
          email: 'test@example.com',
          role: 'admin' 
        },
        expiresIn: 3600
      });

      const result = await mockAuthService.authenticate({
        username: 'testuser',
        password: 'SecurePassword123!'
      });

      expect(result.success).toBe(true);
      expect(result.token).toBe('valid-jwt-token');
      expect(result.refreshToken).toBe('valid-refresh-token');
      expect(result.user.role).toBe('admin');
      expect(result.user.id).toBe(1);
      expect(result.expiresIn).toBe(3600);
    });

    it('TC-004: should successfully validate JWT token with proper structure', async () => {
      mockAuthService.validateToken.mockResolvedValue({
        valid: true,
        decoded: {
          userId: 1,
          username: 'testuser',
          role: 'admin',
          iat: Math.floor(Date.now() / 1000),
          exp: Math.floor(Date.now() / 1000) + 3600
        }
      });

      const result = await mockAuthService.validateToken('valid-jwt-token');

      expect(result.valid).toBe(true);
      expect(result.decoded.userId).toBe(1);
      expect(result.decoded.role).toBe('admin');
      expect(result.decoded.exp).toBeGreaterThan(result.decoded.iat);
    });

    it('TC-004: should successfully refresh expired token', async () => {
      mockAuthService.refreshToken.mockResolvedValue({
        success: true,
        newToken: 'new-jwt-token',
        newRefreshToken: 'new-refresh-token',
        expiresIn: 3600
      });

      const result = await mockAuthService.refreshToken('valid-refresh-token');

      expect(result.success).toBe(true);
      expect(result.newToken).toBe('new-jwt-token');
      expect(result.newRefreshToken).toBe('new-refresh-token');
      expect(result.expiresIn).toBe(3600);
    });

    it('TC-004: should successfully authorize admin user for announcement creation', async () => {
