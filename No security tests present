/**
 * Security Test Suite
 * Tests for XSS protection and other security measures
 */

const { JSDOM } = require('jsdom');
const DOMPurify = require('dompurify');

describe('TC-005: XSS Protection Tests', () => {
  let window, document, purify;

  beforeEach(() => {
    const dom = new JSDOM('<!DOCTYPE html><html><body></body></html>');
    window = dom.window;
    document = window.document;
    purify = DOMPurify(window);
  });

  describe('Happy Path - Safe Content', () => {
    test('TC-005: should allow safe HTML content', () => {
      const safeHtml = '<p>Hello World</p>';
      const sanitized = purify.sanitize(safeHtml);
      expect(sanitized).toBe('<p>Hello World</p>');
    });

    test('TC-005: should preserve safe formatting tags', () => {
      const safeHtml = '<strong>Bold</strong> and <em>italic</em> text';
      const sanitized = purify.sanitize(safeHtml);
      expect(sanitized).toBe('<strong>Bold</strong> and <em>italic</em> text');
    });

    test('TC-005: should handle plain text without modification', () => {
      const plainText = 'Just plain text';
      const sanitized = purify.sanitize(plainText);
      expect(sanitized).toBe('Just plain text');
    });
  });

  describe('Error Path - Malicious Content', () => {
    test('TC-005: should block script tag injection', () => {
      const maliciousHtml = '<script>alert("XSS")</script>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).toBe('');
      expect(sanitized).not.toContain('<script>');
    });

    test('TC-005: should block javascript: protocol in links', () => {
      const maliciousHtml = '<a href="javascript:alert(\'XSS\')">Click me</a>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).not.toContain('javascript:');
      expect(sanitized).toBe('<a>Click me</a>');
    });

    test('TC-005: should block onload event handlers', () => {
      const maliciousHtml = '<img src="x" onload="alert(\'XSS\')">';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).not.toContain('onload');
      expect(sanitized).toBe('<img src="x">');
    });

    test('TC-005: should block data: protocol with javascript', () => {
      const maliciousHtml = '<iframe src="data:text/html,<script>alert(\'XSS\')</script>"></iframe>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).toBe('');
    });

    test('TC-005: should block style injection attacks', () => {
      const maliciousHtml = '<div style="background-image: url(javascript:alert(\'XSS\'))">Content</div>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).not.toContain('javascript:');
      expect(sanitized).toBe('<div>Content</div>');
    });

    test('TC-005: should block nested script attempts', () => {
      const maliciousHtml = '<div><script>alert("nested")</script><p>Content</p></div>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).toBe('<div><p>Content</p></div>');
      expect(sanitized).not.toContain('<script>');
    });

    test('TC-005: should block SVG script injection', () => {
      const maliciousHtml = '<svg onload="alert(\'XSS\')"><script>alert("XSS")</script></svg>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).not.toContain('onload');
      expect(sanitized).not.toContain('<script>');
      expect(sanitized).toBe('<svg></svg>');
    });

    test('TC-005: should block object and embed tags', () => {
      const maliciousHtml = '<object data="javascript:alert(\'XSS\')"></object>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).toBe('');
    });

    test('TC-005: should handle multiple XSS vectors in one payload', () => {
      const maliciousHtml = '<div onclick="alert(1)"><script>alert(2)</script><img src=x onerror="alert(3)"></div>';
      const sanitized = purify.sanitize(maliciousHtml);
      expect(sanitized).not.toContain('onclick');
      expect(sanitized).not.toContain('<script>');
      expect(sanitized).not.toContain('onerror');
      expect(sanitized).toBe('<div><img src="x"></div>');
    });
  });

  describe('Edge Cases', () => {
    test('TC-005: should handle empty input', () => {
      const sanitized = purify.sanitize('');
      expect(sanitized).toBe('');
    });

    test('TC-005: should handle null input', () => {
      const sanitized = purify.sanitize(null);
      expect(sanitized).toBe('');
    });

    test('TC-005: should handle undefined input', () => {
      const sanitized = purify.sanitize(undefined);
      expect(sanitized).toBe('');
    });

    test('TC-005: should handle malformed HTML gracefully', () => {
      const malformedHtml = '<div><p>Unclosed tags<span>';
      const sanitized = purify.sanitize(malformedHtml);
      expect(sanitized).toContain('Unclosed tags');
      expect(sanitized).not.toContain('script');
    });
  });

  describe('Configuration Tests', () => {
    test('TC-005: should respect custom configuration', () => {
      const customConfig = { ALLOWED_TAGS: ['b'] };
      const html = '<b>Bold</b><i>Italic</i>';
      const sanitized = purify.sanitize(html, customConfig);
      expect(sanitized).toContain('<b>Bold</b>');
      expect(sanitized).not.toContain('<i>');
    });

    test('TC-005: should handle whitelist configuration', () => {
      const config = { ALLOWED_TAGS: ['p', 'strong'], ALLOWED_ATTR: [] };
      const html = '<p><strong>Text</strong><script>alert("XSS")</script></p>';
      const sanitized = purify.sanitize(html, config);
      expect(sanitized).toBe('<p><strong>Text</strong></p>');
    });
  });
});

describe('TC-006: Input Validation Tests', () => {
  describe('String Validation', () => {
    test('TC-006: should validate string length limits', () => {
      const validateString = (input, maxLength) => {
        if (typeof input !== 'string') return false;
        if (input.length > maxLength) return false;
        return true;
      };

      expect(validateString('valid', 10)).toBe(true);
      expect(validateString('this is too long', 5)).toBe(false);
      expect(validateString(123, 10)).toBe(false);
    });

    test('TC-006: should validate email format', () => {
      const validateEmail = (email) => {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
      };

      expect(validateEmail('test@example.com')).toBe(true);
      expect(validateEmail('invalid-email')).toBe(false);
      expect(validateEmail('test@')).toBe(false);
    });

    test('TC-006: should validate against SQL injection patterns', () => {
      const hasSqlInjection = (input) => {
        const sqlPatterns = [
          /(\b(SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|EXEC|UNION|SCRIPT)\b)/i,
          /(--|;|\/\*|\*\/)/,
          /(\b(OR|AND)\b.*[=<>])/i
        ];
        return sqlPatterns.some(pattern => pattern.test(input));
      };

      expect(hasSqlInjection('normal text')).toBe(false);
      expect(hasSqlInjection("'; DROP TABLE users; --")).toBe(true);
      expect(hasSqlInjection('1 OR 1=1')).toBe(true);
    });
  });

  describe('File Upload Validation', () => {
    test('TC-006: should validate file extensions', () => {
      const validateFileExtension = (filename, allowedExtensions) => {
        const ext = filename.toLowerCase().split('.').pop();
        return allowedExtensions.includes(ext);
      };

      const allowedExts = ['jpg', 'png', 'gif'];
      expect(validateFileExtension('image.jpg', allowedExts)).toBe(true);
      expect(validateFileExtension('script.exe', allowedExts)).toBe(false);
    });

    test('TC-006: should validate file size limits', () => {
      const validateFileSize = (fileSize, maxSizeInMB) => {
        const maxSizeInBytes = maxSizeInMB * 1024 * 1024;
        return fileSize <= maxSizeInBytes;
      };

      expect(validateFileSize(1048576, 2)).toBe(true); // 1MB file, 2MB limit
      expect(validateFileSize(5242880, 2)).toBe(false); // 5MB file, 2MB limit
    });
  });
});

describe('TC-007: Authentication Security Tests', () => {
  describe('Password Security', () => {
    test('TC-007: should validate strong passwords', () => {
      const validatePassword = (password) => {
        const minLength = 8;
        const hasUpperCase = /[A-Z]/.test(password);
        const hasLowerCase = /[a-z]/.test(password);
        const hasNumbers = /\d/.test(password);
        const hasSpecialChar = /[!@#$%^&*(),.?":{}|<>]/.test(password);

        return password.length >= minLength && hasUpperCase && hasLowerCase && hasNumbers && hasSpecialChar;
      };

      expect(validatePassword('StrongP@ss1')).toBe(true);
      expect(validatePassword('weak')).toBe(false);
      expect(validatePassword('NoSpecialChar1')).toBe(false);
    });

    test('TC-007: should detect common weak passwords', () => {
      const isWeakPassword = (password) => {
        const commonPasswords = ['password', '123456', 'qwerty', 'admin', 'letmein'];
        return commonPasswords.includes(password.toLowerCase());
      };

      expect(isWeakPassword('password')).toBe(true);
      expect(isWeakPassword('UniqueP@ss1')).toBe(false);
    });
  });

  describe('Session Security', () => {
    test('TC-007: should validate session token format', () => {
      const validateSessionToken = (token) => {
        // Check if token is a valid UUID or similar secure format
        const tokenRegex = /^[a-f0-9]{32,}$/i;
        return tokenRegex.test(token) && token.length >= 32;
      };

      expect(validateSessionToken('a1b2c3d4e5f6789012345678901234567890')).toBe(true);
      expect(validateSessionToken('short')).toBe(false);
      expect(validateSessionToken('invalid-chars!')).toBe(false);
    });
  });
});