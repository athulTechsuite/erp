          expected: 'John  Doe'
        },
        {
          input: 'Valid message content',
          expected: 'Valid message content'
        },
        {
          input: 'Test<b>bold</b>text',
          expected: 'Testboldtext'
        },
        {
          input: 'user@example.com<script>hack()</script>',
          expected: 'user@example.com'
        }
      ];

      testCases.forEach(({ input, expected }) => {
        const sanitized = SecurityValidator.sanitizeInput(input);
        expect(sanitized).toBe(expected);
      });
    });

    test('should validate form data through security validator', () => {
      const maliciousData = {
        name: '<script>alert("xss")</script>',
        email: "test'; DROP TABLE users; --",
        message: '<iframe src="javascript:alert()"></iframe>'
      };

      expect(() => {
        window.validateForm(maliciousData);
      }).toThrow('Security validation failed');
    });

    test('should pass clean data through security validation', () => {
      const cleanData = {
        name: 'John Doe',
        email: 'john@example.com',
        message: 'This is a clean message with no malicious content'
      };

      expect(() => {
        const result = window.validateForm(cleanData);
        expect(result).toEqual(cleanData);
      }).not.toThrow();
    });
  });

