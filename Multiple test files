/**
 * TC-004: Announcement form validation functions
 */

function validateAnnouncementTitle(title) {
  if (!title || typeof title !== 'string' || title.trim() === '') {
    return { isValid: false, error: 'Title is required' };
  }
  
  if (title.trim().length > 100) {
    return { isValid: false, error: 'Title must be 100 characters or less' };
  }
  
  if (containsXSSPatterns(title)) {
    return { isValid: false, error: 'Invalid characters detected' };
  }
  
  return { isValid: true, error: null };
}

function validateAnnouncementMessage(message) {
  if (!message || typeof message !== 'string' || message.trim() === '') {
    return { isValid: false, error: 'Message is required' };
  }
  
  if (message.trim().length < 20) {
    return { isValid: false, error: 'Message must be at least 20 characters' };
  }
  
  if (message.trim().length > 1000) {
    return { isValid: false, error: 'Message must be 1000 characters or less' };
  }
  
  if (containsXSSPatterns(message)) {
    return { isValid: false, error: 'Invalid characters detected' };
  }
  
  return { isValid: true, error: null };
}

function validateAnnouncementAuthor(author) {
  if (!author || typeof author !== 'string' || author.trim() === '') {
    return { isValid: false, error: 'Author name is required' };
  }
  
  if (containsXSSPatterns(author)) {
    return { isValid: false, error: 'Invalid characters detected' };
  }
  
  return { isValid: true, error: null };
}

function validateAnnouncementEmail(email) {
  if (!email || typeof email !== 'string' || email.trim() === '') {
    return { isValid: false, error: 'Email is required' };
  }
  
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(email.trim())) {
    return { isValid: false, error: 'Invalid email format' };
  }
  
  return { isValid: true, error: null };
}

function validateAnnouncementPriority(priority) {
  const validPriorities = ['low', 'medium', 'high'];
  if (!priority || !validPriorities.includes(priority)) {
    return { isValid: false, error: 'Please select a valid priority' };
  }
  
  return { isValid: true, error: null };
}

function validateAnnouncementDate(date) {
  if (!date || typeof date !== 'string') {
    return { isValid: false, error: 'Please enter a valid date' };
  }
  
  const inputDate = new Date(date);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  
  if (isNaN(inputDate.getTime())) {
    return { isValid: false, error: 'Please enter a valid date' };
  }
  
  if (inputDate < today) {
    return { isValid: false, error: 'Date must be today or in the future' };
  }
  
  return { isValid: true, error: null };
}

function validateAnnouncementForm(formData) {
  const errors = [];
  
  const titleResult = validateAnnouncementTitle(formData.title);
  if (!titleResult.isValid) errors.push('title');
  
  const messageResult = validateAnnouncementMessage(formData.message);
  if (!messageResult.isValid) errors.push('message');
  
  const authorResult = validateAnnouncementAuthor(formData.author);
  if (!authorResult.isValid) errors.push('author');
  
  const emailResult = validateAnnouncementEmail(formData.email);
  if (!emailResult.isValid) errors.push('email');
  
  const priorityResult = validateAnnouncementPriority(formData.priority);
  if (!priorityResult.isValid) errors.push('priority');
  
  const dateResult = validateAnnouncementDate(formData.date);
  if (!dateResult.isValid) errors.push('date');
  
  return {
    isValid: errors.length === 0,
    errors: errors
  };
}

function validateAnnouncementFormDOM(form) {
  const formData = {
    title: form.querySelector('#announcement-title').value,
    message: form.querySelector('#announcement-message').value,
    author: form.querySelector('#announcement-author').value,
    email: form.querySelector('#announcement-email').value,
    priority: form.querySelector('#announcement-priority').value,
    date: form.querySelector('#announcement-date').value
  };
  
  return validateAnnouncementForm(formData);
}

function containsXSSPatterns(input) {
  const xssPatterns = [
    /<script/i,
    /<iframe/i,
    /<img[^>]+onerror/i,
    /javascript:/i,
    /<object/i,
    /<embed/i
  ];
  
  return xssPatterns.some(pattern => pattern.test(input));
}

function displayValidationError(errorElement, message) {
  if (errorElement) {
    errorElement.textContent = message;
    errorElement.style.display = 'block';
    errorElement.setAttribute('role', 'alert');
    errorElement.setAttribute('aria-live', 'polite');
  }
}

function clearValidationError(errorElement) {
  if (errorElement) {
    errorElement.textContent = '';
    errorElement.style.display = 'none';
    errorElement.removeAttribute('role');
    errorElement.removeAttribute('aria-live');
  }
}

function displaySuccessMessage(successElement, message) {
  if (successElement) {
    successElement.textContent = message;
    successElement.style.display = 'block';
    successElement.setAttribute('role', 'status');
    successElement.setAttribute('aria-live', 'polite');
  }
}

// Export functions for use in other modules
if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    validateAnnouncementTitle,
    validateAnnouncementMessage,
    validateAnnouncementAuthor,
    validateAnnouncementEmail,
    validateAnnouncementPriority,
    validateAnnouncementDate,
    validateAnnouncementForm,
    validateAnnouncementFormDOM,
    displayValidationError,
    clearValidationError,
    displaySuccessMessage,
    containsXSSPatterns
  };
}