    });

    describe('Happy Path', () => {
      it('should handle concurrent announcement creation within performance limits', async () => {
        const concurrentRequests = 100;
        const maxResponseTime = 5000; // 5 seconds
        const announcementData = {
          title: 'Load Test Announcement',
          content: 'Performance testing content',
          priority: 'medium'
        };

        mockDb.create.resolves({ id: 1, ...announcementData });
        
        const startTime = Date.now();
        const promises = Array.from({ length: concurrentRequests }, () => 
          announcementManager.createAnnouncement(announcementData)
        );
        
        const results = await Promise.all(promises);
        const endTime = Date.now();
        const totalTime = endTime - startTime;

        expect(results).to.have.length(concurrentRequests);
        expect(totalTime).to.be.below(maxResponseTime);
        expect(mockDb.create.callCount).to.equal(concurrentRequests);
        
        results.forEach(result => {
          expect(result).to.have.property('id');
          expect(result.title).to.equal(announcementData.title);
        });
      });

