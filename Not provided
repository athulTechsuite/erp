  // API-001: API endpoint security tests
  describe('API-001: API endpoint security tests', () => {
    let mockRequest;
    let mockResponse;
    let mockNext;
    let authMiddleware;
    let rateLimitMiddleware;
    let validationMiddleware;

    beforeEach(() => {
      mockRequest = {
        headers: {},
        body: {},
        ip: '127.0.0.1',
        user: null
      };
      mockResponse = {
        status: sinon.stub().returnsThis(),
        json: sinon.stub().returnsThis(),
        send: sinon.stub().returnsThis()
      };
      mockNext = sinon.stub();
      
      // Mock security middlewares
      authMiddleware = {
        authenticate: sinon.stub(),
        authorize: sinon.stub()
      };
      rateLimitMiddleware = {
        limit: sinon.stub()
      };
      validationMiddleware = {
        validateInput: sinon.stub()
      };
    });

    describe('Happy Path', () => {
      it('should allow authenticated user to access protected endpoint', async () => {
        mockRequest.headers['authorization'] = 'Bearer valid-jwt-token';
        mockRequest.user = { id: 1, role: 'admin' };

        authMiddleware.authenticate.callsArg(2); // Call next()
        authMiddleware.authorize.callsArg(2); // Call next()

        // Simulate successful authentication flow
        authMiddleware.authenticate(mockRequest, mockResponse, mockNext);
        expect(mockNext.calledOnce).to.be.true;

        authMiddleware.authorize(mockRequest, mockResponse, mockNext);
        expect(mockNext.calledTwice).to.be.true;
        expect(mockResponse.status.called).to.be.false;
      });

      it('should accept requests within rate limits', async () => {
        mockRequest.ip = '192.168.1.100';
        
        rateLimitMiddleware.limit.callsArg(2); // Call next()

        rateLimitMiddleware.limit(mockRequest, mockResponse, mockNext);
        
        expect(mockNext.calledOnce).to.be.true;
        expect(mockResponse.status.called).to.be.false;
      });

      it('should process valid input data through validation', async () => {
        mockRequest.body = {
          title: 'Valid Announcement',
          content: 'This is valid content for the announcement',
          priority: 'medium'
        };

        validationMiddleware.validateInput.callsArg(2); // Call next()

        validationMiddleware.validateInput(mockRequest, mockResponse, mockNext);

        expect(mockNext.calledOnce).to.be.true;
        expect(mockResponse.status.called).to.be.false;
      });

      it('should allow HTTPS requests with proper headers', async () => {
        mockRequest.headers = {
          'authorization': 'Bearer valid-token',
          'content-type': 'application/json',
          'x-requested-with': 'XMLHttpRequest'
        };
        mockRequest.secure = true;
        mockRequest.protocol = 'https';

        const securityCheck = (req, res, next) => {
          if (req.secure && req.headers['authorization']) {
            next();
          } else {
            res.status(403).json({ error: 'Secure connection required' });
          }
        };

        securityCheck(mockRequest, mockResponse, mockNext);

        expect(mockNext.calledOnce).to.be.true;
        expect(mockResponse.status.called).to.be.false;
      });
    });

    describe('Error Path', () => {
      it('should reject requests without valid authentication', async () => {
        mockRequest.headers = {}; // No authorization header

        authMiddleware.authenticate.callsFake((req, res, next) => {
          res.status(401).json({ error: 'Authentication required' });
        });

        authMiddleware.authenticate(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(401)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'Authentication required' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });

      it('should reject requests with invalid JWT tokens', async () => {
        mockRequest.headers['authorization'] = 'Bearer invalid-token';

        authMiddleware.authenticate.callsFake((req, res, next) => {
          res.status(401).json({ error: 'Invalid token' });
        });

        authMiddleware.authenticate(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(401)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'Invalid token' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });

      it('should block requests exceeding rate limits', async () => {
        mockRequest.ip = '192.168.1.100';

        rateLimitMiddleware.limit.callsFake((req, res, next) => {
          res.status(429).json({ error: 'Rate limit exceeded' });
        });

        rateLimitMiddleware.limit(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(429)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'Rate limit exceeded' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });

      it('should reject requests with malicious input', async () => {
        mockRequest.body = {
          title: '<script>alert("xss")</script>',
          content: 'SELECT * FROM users; DROP TABLE announcements;',
          priority: 'high'
        };

        validationMiddleware.validateInput.callsFake((req, res, next) => {
          res.status(400).json({ error: 'Invalid input detected' });
        });

        validationMiddleware.validateInput(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(400)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'Invalid input detected' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });

      it('should reject requests without proper CSRF protection', async () => {
        mockRequest.headers = {
          'authorization': 'Bearer valid-token',
          'content-type': 'application/json'
          // Missing CSRF token
        };

        const csrfMiddleware = (req, res, next) => {
          if (!req.headers['x-csrf-token']) {
            res.status(403).json({ error: 'CSRF token required' });
          } else {
            next();
          }
        };

        csrfMiddleware(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(403)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'CSRF token required' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });

      it('should block requests from unauthorized IP addresses', async () => {
        mockRequest.ip = '10.0.0.1'; // Blocked IP range
        mockRequest.headers['authorization'] = 'Bearer valid-token';

        const ipWhitelistMiddleware = (req, res, next) => {
          const allowedIPs = ['127.0.0.1', '192.168.1.0/24'];
          if (!allowedIPs.some(ip => req.ip.startsWith(ip.split('/')[0]))) {
            res.status(403).json({ error: 'IP address not authorized' });
          } else {
            next();
          }
        };

        ipWhitelistMiddleware(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(403)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'IP address not authorized' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });

      it('should reject requests with insufficient permissions', async () => {
        mockRequest.headers['authorization'] = 'Bearer valid-token';
        mockRequest.user = { id: 2, role: 'user' }; // Regular user, not admin

        authMiddleware.authenticate.callsArg(2); // Authentication passes
        authMiddleware.authorize.callsFake((req, res, next) => {
          if (req.user.role !== 'admin') {
            res.status(403).json({ error: 'Insufficient permissions' });
          } else {
            next();
          }
        });

        authMiddleware.authenticate(mockRequest, mockResponse, mockNext);
        authMiddleware.authorize(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(403)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'Insufficient permissions' })).to.be.true;
      });

      it('should handle SQL injection attempts in query parameters', async () => {
        mockRequest.query = {
          id: "1; DROP TABLE announcements; --"
        };

        const sqlInjectionMiddleware = (req, res, next) => {
          const sqlPatterns = [/;\s*(drop|delete|insert|update)/i, /union\s+select/i, /--/];
          const queryString = JSON.stringify(req.query);
          
          if (sqlPatterns.some(pattern => pattern.test(queryString))) {
            res.status(400).json({ error: 'SQL injection attempt detected' });
          } else {
            next();
          }
        };

        sqlInjectionMiddleware(mockRequest, mockResponse, mockNext);

        expect(mockResponse.status.calledWith(400)).to.be.true;
        expect(mockResponse.json.calledWith({ error: 'SQL injection attempt detected' })).to.be.true;
        expect(mockNext.called).to.be.false;
      });
    });
  });

