  describe('TC-004 Error Path - Unauthorized access and security violations', () => {
    it('should deny access to unauthenticated users', () => {
      const unauthenticatedContext = {
        user: null,
        isAuthenticated: false,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={unauthenticatedContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should deny access to users with insufficient privileges', () => {
      const regularUserContext = {
        user: { id: 'user123', role: 'user' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={regularUserContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      expect(screen.getByText(/insufficient privileges/i)).toBeInTheDocument();
      expect(screen.queryByRole('form')).not.toBeInTheDocument();
    });

    it('should handle token expiration gracefully', async () => {
      const user = userEvent.setup();
      const expiredTokenContext = {
        user: { id: 'admin123', role: 'admin' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      const mockSubmitTokenError = jest.fn().mockRejectedValue({
        response: { status: 401, data: { message: 'Token expired' } }
      });

      render(
        <TestWrapper authContext={expiredTokenContext}>
          <AnnouncementForm onSubmit={mockSubmitTokenError} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'Test Title');
      await user.type(screen.getByLabelText(/content/i), 'Test content');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/session expired.*please log in again/i)).toBeInTheDocument();
      });

      expect(expiredTokenContext.logout).toHaveBeenCalled();
    });

    it('should prevent CSRF attacks by validating request tokens', async () => {
      const user = userEvent.setup();
      const mockSubmitCSRF = jest.fn().mockRejectedValue({
        response: { status: 403, data: { message: 'CSRF token mismatch' } }
      });

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitCSRF} />
        </TestWrapper>
      );

      await user.type(screen.getByLabelText(/title/i), 'CSRF Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing CSRF protection');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(screen.getByText(/security validation failed/i)).toBeInTheDocument();
      });
    });

    it('should sanitize user input to prevent XSS attacks', async () => {
      const user = userEvent.setup();
      const mockSubmitSanitized = jest.fn();

      render(
        <TestWrapper>
          <AnnouncementForm onSubmit={mockSubmitSanitized} />
        </TestWrapper>
      );

      const maliciousTitle = '<script>alert("xss")</script>Announcement';
      const maliciousContent = '<img src="x" onerror="alert(\'xss\')" />Content';

      await user.type(screen.getByLabelText(/title/i), maliciousTitle);
      await user.type(screen.getByLabelText(/content/i), maliciousContent);
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmitSanitized).toHaveBeenCalledWith(
          expect.objectContaining({
            title: expect.not.stringContaining('<script>'),
            content: expect.not.stringContaining('<img')
          })
        );
      });
    });
  });
});

describe('TC-006: Authentication/Authorization', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('TC-006 Happy Path - Successful authentication and authorization flows', () => {
    it('should authenticate user with valid credentials and grant appropriate access', async () => {
      const user = userEvent.setup();
      const mockLogin = jest.fn().mockResolvedValue({
        user: { id: 'admin123', role: 'admin', email: 'admin@test.com' },
        token: 'valid-jwt-token'
      });

      const authContext = {
        user: null,
        isAuthenticated: false,
        login: mockLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Initial state - should show login prompt
      expect(screen.getByText(/please log in to access this feature/i)).toBeInTheDocument();

      // Simulate successful login
      await act(async () => {
        await mockLogin('admin@test.com', 'valid-password');
      });

      // Re-render with authenticated context
      const authenticatedContext = {
        user: { id: 'admin123', role: 'admin', email: 'admin@test.com' },
        isAuthenticated: true,
        login: mockLogin,
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={authenticatedContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Should now show the form
      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
    });

    it('should maintain user session and verify token validity across requests', async () => {
      const user = userEvent.setup();
      const mockTokenValidation = jest.fn().mockResolvedValue({ valid: true });
      const mockSubmitWithToken = jest.fn().mockResolvedValue({ success: true });

      const authContext = {
        user: { id: 'admin123', role: 'admin', token: 'valid-jwt-token' },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn(),
        validateToken: mockTokenValidation
      };

      render(
        <TestWrapper authContext={authContext}>
          <AnnouncementForm onSubmit={mockSubmitWithToken} />
        </TestWrapper>
      );

      // Fill and submit form
      await user.type(screen.getByLabelText(/title/i), 'Session Test');
      await user.type(screen.getByLabelText(/content/i), 'Testing session maintenance');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmitWithToken).toHaveBeenCalledWith(
          expect.objectContaining({
            title: 'Session Test',
            content: 'Testing session maintenance'
          })
        );
      });
    });

    it('should properly authorize admin users for all operations', async () => {
      const user = userEvent.setup();
      const adminContext = {
        user: { id: 'admin123', role: 'admin', permissions: ['create', 'edit', 'delete', 'moderate'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={adminContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Admin should have access to all form features
      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
      expect(screen.getByLabelText(/content/i)).toBeEnabled();
      
      // Check for admin-specific features
      const prioritySelect = screen.queryByLabelText(/priority/i);
      if (prioritySelect) {
        expect(prioritySelect).toBeEnabled();
      }

      await user.type(screen.getByLabelText(/title/i), 'Admin Announcement');
      await user.type(screen.getByLabelText(/content/i), 'Administrative announcement content');
      await user.click(screen.getByRole('button', { name: /submit/i }));

      await waitFor(() => {
        expect(mockSubmit).toHaveBeenCalled();
      });
    });

    it('should handle role-based permissions correctly for moderators', async () => {
      const user = userEvent.setup();
      const moderatorContext = {
        user: { id: 'mod123', role: 'moderator', permissions: ['create', 'edit', 'moderate'] },
        isAuthenticated: true,
        login: jest.fn(),
        logout: jest.fn()
      };

      render(
        <TestWrapper authContext={moderatorContext}>
          <AnnouncementForm onSubmit={mockSubmit} />
        </TestWrapper>
      );

      // Moderator should have access to form but possibly limited features
      expect(screen.getByRole('form')).toBeInTheDocument();
      expect(screen.getByLabelText(/title/i)).toBeEnabled();
      expect(screen.getByLabelText(/content/i)).toBeEnabled();

      await user.type(screen.getByLabelText(/title/i), 'Moderator Announcement');
      await user.type(screen.getByLabelText(/content/i), 'Moderator announcement content');
