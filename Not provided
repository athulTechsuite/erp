        );
        
        const results = await Promise.all(promises);
        const endTime = Date.now();
        const totalTime = endTime - startTime;
        const averageResponseTime = totalTime / concurrentReads;

        expect(results).to.have.length(concurrentReads);
        expect(averageResponseTime).to.be.below(10); // Average response time under 10ms
        expect(mockDb.findById.callCount).to.equal(concurrentReads);
        
        results.forEach(result => {
          expect(result).to.deep.equal(expectedAnnouncement);
        });
