      await waitFor(() => {
        expect(mockFetchAnnouncements).toHaveBeenCalled();
        expect(screen.getByText('Test Announcement 1')).toBeInTheDocument();
        expect(screen.getByText('Test Announcement 2')).toBeInTheDocument();
      });

      // Verify READ operation displays correct content
      expect(screen.getByText('This is test content for announcement 1')).toBeInTheDocument();
      expect(screen.getByText('This is test content for announcement 2')).toBeInTheDocument();
    });

    it('should update an existing announcement successfully', async () => {
      const user = userEvent.setup();
      const existingAnnouncement = mockAnnouncements[0];
      const mockUpdateSubmit = jest.fn().mockResolvedValue({
        ...existingAnnouncement,
        title: 'Updated Announcement Title',
        content: 'Updated announcement content'
      });

      render(
        <TestWrapper>
          <AnnouncementForm 
            onSubmit={mockUpdateSubmit} 
            mode="update"
            initialData={existingAnnouncement}
          />
        </TestWrapper>
      );

      // Verify form is pre-populated for UPDATE
      expect(screen.getByDisplayValue('Test Announcement 1')).toBeInTheDocument();
      
      // Modify fields for UPDATE operation
      const titleInput = screen.getByLabelText(/title/i);
      const contentInput = screen.getByLabelText(/content/i);
      
      await user.clear(titleInput);
      await user.clear(contentInput);
      await user.type(titleInput, 'Updated Announcement Title');
      await user.type(contentInput, 'Updated announcement content');

      // Submit UPDATE
      await user.click(screen.getByRole('button', { name: /update|save/i }));

      await waitFor(() => {
        expect(mockUpdateSubmit).toHaveBeenCalledWith({
          id: '1',
          title: 'Updated Announcement Title',
          content: 'Updated announcement content',
          category: 'general',
          createdAt: '2024-01-01T00:00:00Z',
          author: { id: 'admin1', name: 'Admin User' }
        });
      });
    });

    it('should delete an announcement successfully', async () => {
      const user = userEvent.setup();
      const mockDeleteAction = jest.fn().mockResolvedValue({ success: true });

      render(
        <TestWrapper>
          <AnnouncementDetail 
            announcement={mockAnnouncements[0]}
            onDelete={mockDeleteAction}
            canDelete={true}
          />
        </TestWrapper>
      );

      // Find and click DELETE button
      const deleteButton = screen.getByRole('button', { name: /delete/i });
      await user.click(deleteButton);

      // Confirm deletion in modal/dialog
      const confirmButton = await screen.findByRole('button', { name: /confirm|yes/i });
      await user.click(confirmButton);

      await waitFor(() => {
        expect(mockDeleteAction).toHaveBeenCalledWith('1');
